load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//:internal"])

# Status::SetPayload type-URL constants used to classify
# ParseAndCheck failures without substring-matching the message.
# Header-only — included by parse_and_check.cc (producer) and the
# conformance harness (consumer).  See status_tags.h for the payload
# contract.
cc_library(
    name = "status_tags",
    hdrs = ["status_tags.h"],
    deps = [
        "@com_google_absl//absl/strings",
    ],
)

# Parse + type-check + static-subset enforcement.  v1's separate
# compiler/ir/static_subset library is folded into this one: ParseAndCheck
# returns a TypedAst only if RejectDyn passes.  See rewrite plan §4.
cc_library(
    name = "parse_and_check",
    srcs = ["parse_and_check.cc"],
    hdrs = ["parse_and_check.h"],
    deps = [
        ":status_tags",
        "//compiler/celfn:function_library",
        "//compiler/ir:annotations",
        "//compiler/ir:typed_ast",
        "@com_google_cel_spec//proto/cel/expr:syntax_cc_proto",
        "@cel-cpp//checker:optional",
        "@cel-cpp//checker:standard_library",
        "@cel-cpp//checker:type_checker",
        "@cel-cpp//checker:type_checker_builder",
        "@cel-cpp//checker:type_checker_builder_factory",
        "@cel-cpp//checker:validation_result",
        "@cel-cpp//common:ast",
        "@cel-cpp//common:ast_proto",
        "@cel-cpp//common:decl",
        "@cel-cpp//common:expr",
        "@cel-cpp//common:source",
        "@cel-cpp//common:type",
        "@cel-cpp//extensions:bindings_ext",
        "@cel-cpp//extensions:comprehensions_v2",
        "@cel-cpp//extensions:encoders",
        "@cel-cpp//extensions:math_ext_decls",
        "@cel-cpp//extensions:math_ext_macros",
        "@cel-cpp//extensions:strings",
        "@cel-cpp//parser",
        "@cel-cpp//parser:macro_registry",
        "@cel-cpp//parser:options",
        "@cel-cpp//parser:standard_macros",
        "@com_google_absl//absl/base:nullability",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_protobuf//:protobuf",
        "@com_google_protobuf//src/google/protobuf/compiler:importer",
    ],
)

cc_test(
    name = "parse_and_check_test",
    size = "large",
    srcs = ["parse_and_check_test.cc"],
    data = [
        "parse_and_check.h",
        "//testdata:e2e_fixture.proto",
    ],
    deps = [
        ":parse_and_check",
        "//compiler/ir:annotations",
        "//compiler/ir:typed_ast",
        "@cel-cpp//common:ast",
        "@cel-cpp//common:expr",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:status_matchers",
        "@com_google_absl//absl/strings",
        "@com_google_googletest//:gtest_main",
        "@com_google_protobuf//:protobuf",
    ],
)
