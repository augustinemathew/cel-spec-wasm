load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//compiler:__subpackages__"])

# Pure attribute-pattern machinery: no wasm / wasmtime dep, so it can
# be unit-tested and reused by any embedder that wants to mark
# attributes as UNKNOWN.  Ported (trimmed) from cel-cpp's
# `base/attribute.{h,cc}`.
cc_library(
    name = "attribute",
    srcs = ["attribute.cc"],
    hdrs = ["attribute.h"],
    deps = [
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/types:span",
    ],
)

cc_test(
    name = "attribute_test",
    srcs = ["attribute_test.cc"],
    deps = [
        ":attribute",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:status_matchers",
        "@com_google_googletest//:gtest_main",
    ],
)

# Pure host-side logic for `cel_host.{get_field, has_field, message_eq}`.
# No wasmtime dependency — unit-testable on any host.  The wasmtime glue
# that wires these into a linker lives in `cel_host_wasmtime.{h,cc}`
# (added alongside G2 codegen).
cc_library(
    name = "cel_host",
    srcs = ["cel_host.cc"],
    hdrs = ["cel_host.h"],
    deps = [
        "//compiler/runtime:cel_runtime",
        "@com_google_absl//absl/base:core_headers",
        "@com_google_absl//absl/functional:any_invocable",
        "@com_google_protobuf//:protobuf",
    ],
)

cc_test(
    name = "cel_host_test",
    srcs = ["cel_host_test.cc"],
    deps = [
        ":cel_host",
        "//compiler/runtime:cel_runtime",
        "//compiler/testdata:host_fixture_proto2_cc_proto",
        "//compiler/testdata:host_fixture_proto3_cc_proto",
        "@com_google_absl//absl/log:check",
        "@com_google_absl//absl/strings",
        "@com_google_googletest//:gtest_main",
        "@com_google_protobuf//:protobuf",
    ],
)

# Host-side implementation of the `cel_env.cel_log` import emitted by
# the runtime module (and declared unconditionally by every eval
# module).  Splits into a runtime-agnostic decoder + sink abstraction
# plus a wasmtime trampoline that wires the import onto a linker.
# Same darwin-arm64 constraint as `:host_loader` (wasmtime dep).
cc_library(
    name = "cel_log",
    srcs = ["cel_log.cc"],
    hdrs = ["cel_log.h"],
    deps = [
        "//compiler/runtime:cel_runtime",
        "@com_google_absl//absl/base:core_headers",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/strings:str_format",
        "@com_google_absl//absl/types:span",
        "@wasmtime_darwin_arm64//:wasmtime",
    ],
)

cc_test(
    name = "cel_log_test",
    srcs = ["cel_log_test.cc"],
    deps = [
        ":cel_log",
        "//compiler/runtime:cel_runtime",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/types:span",
        "@com_google_googletest//:gtest_main",
    ],
)

# wasmtime-specific glue that registers the `cel_host.*` imports on a
# linker by forwarding them to the pure-host logic in `:cel_host`.
# Same darwin-arm64 constraint as `:host_loader` (wasmtime dep).
cc_library(
    name = "cel_host_wasmtime",
    srcs = ["cel_host_wasmtime.cc"],
    hdrs = ["cel_host_wasmtime.h"],
    deps = [
        ":attribute",
        ":cel_host",
        "//compiler/runtime:cel_runtime",
        "@com_google_absl//absl/base:core_headers",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/strings",
        "@com_google_protobuf//:protobuf",
        "@wasmtime_darwin_arm64//:wasmtime",
    ],
)

# Two-module loader.  Only buildable on darwin-arm64 today — the same
# constraint as //compiler/e2e:* — because we vendor wasmtime only for
# that triple.  If another triple is added to MODULE.bazel, flip the
# wasmtime dep to a `select()`.
cc_library(
    name = "host_loader",
    srcs = ["host_loader.cc"],
    hdrs = ["host_loader.h"],
    deps = [
        ":cel_host_wasmtime",
        ":cel_log",
        "//compiler/codegen:cel_abi_cc_proto",
        "//compiler/runtime:cel_runtime_wasm_bytes",
        "@com_google_absl//absl/base:core_headers",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/types:span",
        "@wasmtime_darwin_arm64//:wasmtime",
    ],
)

cc_test(
    name = "host_loader_test",
    srcs = ["host_loader_test.cc"],
    deps = [
        ":cel_log",
        ":host_loader",
        "//compiler/codegen:expr_lower",
        "//compiler/codegen:module",
        "//compiler/frontend:parse_and_check",
        "@binaryen//:binaryen",
        "@com_google_absl//absl/log:check",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:status_matchers",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/types:span",
        "@com_google_googletest//:gtest_main",
        "@wasmtime_darwin_arm64//:wasmtime",
    ],
)
