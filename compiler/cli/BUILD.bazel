load("@rules_cc//cc:defs.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "celwasmc",
    srcs = ["celwasmc_main.cc"],
    deps = [
        "//compiler/codegen:abi",
        "//compiler/codegen:expr_lower",
        "//compiler/codegen:module",
        "//compiler/frontend:parse_and_check",
        "//compiler/ir:annotations",
        "//compiler/ir:static_subset",
        "//compiler/ir:typed_ast",
        "//proto/cel/expr:checked_cc_proto",
        "//proto/cel/expr:syntax_cc_proto",
        "@cel-cpp//common:ast_proto",
        "@cel-cpp//parser",
        "@com_google_absl//absl/flags:flag",
        "@com_google_absl//absl/flags:parse",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
    ],
)

sh_test(
    name = "emit_wasm_test",
    srcs = ["emit_wasm_test.sh"],
    data = [
        ":celwasmc",
        "//compiler/testdata:e2e_fixture.proto",
    ],
)

# Compile-and-run CLI.  Depends on `//compiler/host:host_loader`, which
# transitively pulls in `@wasmtime_darwin_arm64`, so like the rest of
# the eval stack this target only builds on darwin-arm64 today.
cc_binary(
    name = "celwasmc-eval",
    srcs = ["celwasmc_eval_main.cc"],
    deps = [
        "//compiler/codegen:abi",
        "//compiler/codegen:expr_lower",
        "//compiler/codegen:module",
        "//compiler/frontend:parse_and_check",
        "//compiler/host:attribute",
        "//compiler/host:host_loader",
        "//compiler/ir:static_subset",
        "//compiler/ir:typed_ast",
        "@com_google_absl//absl/flags:flag",
        "@com_google_absl//absl/flags:parse",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/types:span",
        "@wasmtime_darwin_arm64//:wasmtime",
    ],
)

sh_test(
    name = "celwasmc_eval_test",
    srcs = ["celwasmc_eval_test.sh"],
    data = [
        ":celwasmc-eval",
        "//compiler/testdata:e2e_fixture.proto",
    ],
)
