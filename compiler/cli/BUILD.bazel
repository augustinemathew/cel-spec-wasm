load("@rules_cc//cc:defs.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "celwasmc",
    srcs = ["celwasmc_main.cc"],
    deps = [
        "//compiler/codegen:expr_lower",
        "//compiler/codegen:module",
        "//compiler/frontend:parse_and_check",
        "//compiler/ir:annotations",
        "//compiler/ir:static_subset",
        "//compiler/ir:typed_ast",
        "//proto/cel/expr:checked_cc_proto",
        "//proto/cel/expr:syntax_cc_proto",
        "@cel-cpp//common:ast_proto",
        "@cel-cpp//parser",
        "@com_google_absl//absl/flags:flag",
        "@com_google_absl//absl/flags:parse",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
    ],
)

sh_test(
    name = "emit_wasm_test",
    srcs = ["emit_wasm_test.sh"],
    data = [":celwasmc"],
)
