load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//compiler:__subpackages__"])

# Native-host build of the runtime, used by the unit tests and eventually
# by codegen to import the same layout constants.
cc_library(
    name = "cel_runtime",
    srcs = ["cel_runtime.c"],
    hdrs = ["cel_runtime.h"],
    copts = [
        "-std=c11",
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
    ],
)

cc_test(
    name = "cel_runtime_test",
    srcs = ["cel_runtime_test.cc"],
    deps = [
        ":cel_runtime",
        "@com_google_googletest//:gtest_main",
    ],
)

# Wasm32 cross-compile of the same C source.  Apple clang does not ship a
# wasm32 backend, so the genrule shells out to brew's llvm (22.x) and lld
# (`wasm-ld`).  The output is a freestanding wasm32 module — no WASI, no
# libc, no start function — that exports every `cel_*` symbol plus
# `memory`.  Codegen will `BinaryenModuleRead` the bytes and append the
# per-expression `eval` function on top (M3 is the first caller once
# string constants land).
#
# `-ffreestanding -nostdlib` is mandatory: clang otherwise tries to pull in
# the host libc.  The C source stubs `memcpy` / `memset` / `memcmp` inline
# behind `#if defined(__wasm__)` so no compiler-rt linkage is needed.
# `-Wl,--export-all` is coarse but acceptable for M2: the module is small
# and non-cel exports (`__wasm_call_ctors`, stack pointer, …) are harmless
# to carry into the merged module.  Tighten to `-Wl,--export=cel_*` once
# the merge step lands.
genrule(
    name = "cel_runtime_wasm_file",
    srcs = [
        "cel_runtime.c",
        "cel_runtime.h",
        "wasm_imports.txt",
    ],
    outs = ["cel_runtime.wasm"],
    cmd = " ".join([
        "/opt/homebrew/opt/llvm/bin/clang",
        "--target=wasm32",
        "-ffreestanding",
        "-nostdlib",
        "-O2",
        "-Wl,--no-entry",
        "-Wl,--export-all",
        # Host-imported symbols (see `import_module` / `import_name`
        # attributes in cel_runtime.h).  An explicit allow-list rather
        # than `--allow-undefined` — a typo that introduces a new
        # undefined reference now fails at link time instead of at
        # instantiation.  Add to wasm_imports.txt when a new host
        # import lands.
        "-Wl,--allow-undefined-file=$(location :wasm_imports.txt)",
        "-I.",
        "-o $@",
        "$(location :cel_runtime.c)",
    ]),
    tags = [
        # Depends on a brew-installed toolchain at a fixed absolute path;
        # do not try to run this on machines without `/opt/homebrew/opt/llvm`
        # (i.e. non-darwin or without brew llvm).
        "manual",
        "no-sandbox",
    ],
)

# Embed the cross-compiled wasm bytes as a C++ byte array.  `xxd -i` would
# be the idiomatic tool but it is not guaranteed to be on every machine;
# the shell one-liner below produces the same artefact using od + awk.
genrule(
    name = "cel_runtime_wasm_bytes_cc",
    srcs = [":cel_runtime_wasm_file"],
    outs = ["cel_runtime_wasm_bytes.cc"],
    cmd = """
set -e
src=$(location :cel_runtime_wasm_file)
{
  echo '// Auto-generated by //compiler/runtime:cel_runtime_wasm_bytes_cc.'
  echo '// Do not edit by hand; re-run the genrule to refresh.'
  echo '#include "compiler/runtime/cel_runtime_wasm_bytes.h"'
  echo
  echo 'namespace celwasm {'
  echo
  echo 'const unsigned char kCelRuntimeWasmBytes[] = {'
  od -An -tu1 -v "$$src" | awk '{ for (i=1;i<=NF;i++) printf "0x%02x,", $$i; print "" }'
  echo '};'
  echo 'const unsigned int kCelRuntimeWasmBytesSize = sizeof(kCelRuntimeWasmBytes);'
  echo
  echo '}  // namespace celwasm'
} > $@
""",
    tags = ["manual"],
)

cc_library(
    name = "cel_runtime_wasm_bytes",
    srcs = [":cel_runtime_wasm_bytes_cc"],
    hdrs = ["cel_runtime_wasm_bytes.h"],
    tags = ["manual"],
)
