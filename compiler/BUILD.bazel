load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//bazel:link_mode_test.bzl", "link_mode_cc_test")

package(default_visibility = ["//compiler:__subpackages__"])

# cel::Program — the compiled artifact.  Pure data: bytes +
# (future) ABI.  No wasmtime dep; can be serialized + shipped.
cc_library(
    name = "program",
    hdrs = ["program.h"],
    visibility = ["//visibility:public"],
    deps = [
        "@com_google_absl//absl/types:span",
    ],
)

# Single source of truth for compile-time memory-layout constants
# the compiler reasons about (workspace ceiling, slot stride,
# rodata base, guard band before wasi-libc, etc.).  Anything that
# needs to bound a wasm linear-memory offset goes through this
# header rather than re-typing the magic number.  Mirrors the
# runtime-side C macros in `//runtime:cel_layout`; the
# `static_assert`s in the header check parity on every build.
cc_library(
    name = "memory_layout",
    hdrs = ["memory_layout.h"],
    visibility = ["//:internal"],
    deps = [
        "//runtime:cel_layout",
    ],
)

cc_test(
    name = "memory_layout_test",
    size = "small",
    srcs = ["memory_layout_test.cc"],
    deps = [
        ":memory_layout",
        "@com_google_googletest//:gtest_main",
    ],
)

cc_test(
    name = "program_test",
    size = "small",
    srcs = ["program_test.cc"],
    deps = [
        ":program",
        "@com_google_googletest//:gtest_main",
    ],
)

# cel::Compiler — pure compile-time front end.  Wraps the
# existing celwasm::Compile pipeline; produces cel::Program.  No
# wasmtime dep.
cc_library(
    name = "compiler",
    srcs = ["compiler.cc"],
    hdrs = ["compiler.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":program",
        "//abi:plugin",
        "//shared:type",
        "//compiler/internal:compile",
        "//compiler/celfn:function_library",
        "@com_google_absl//absl/base:core_headers",
        "@com_google_absl//absl/base:nullability",
        "@com_google_absl//absl/container:flat_hash_set",
        "@com_google_absl//absl/log:absl_check",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/types:span",
    ],
)

# m28 — dual-mode coverage: emits compiler_test_dynamic AND
# compiler_test_static so the same body runs against both link modes.
link_mode_cc_test(
    name = "compiler_test",
    size = "small",
    srcs = ["compiler_test.cc"],
    deps = [
        ":compiler",
        ":program",
        "//abi:plugin",
        "//abi:wasm_binary",
        "//bazel:link_mode_test_helpers",
        "//shared:type",
        "//testdata:e2e_fixture_cc_proto",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:status_matchers",
        "@com_google_absl//absl/strings:string_view",
        "@com_google_googletest//:gtest_main",
    ],
)
