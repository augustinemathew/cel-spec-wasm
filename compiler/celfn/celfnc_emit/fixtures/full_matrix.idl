// Comprehensive m26 fixture — one foreign-fn decl per CEL type
// (every row in the m24 §6 matrix the celfnc emitters handle).
//
// This file is the **single source of truth** for the
// full-matrix integration suite: cel generate runs against it,
// the four emitted files (fns.wit, codec.h, generated_stub.cc,
// user_fns.h) are captured via genrules, and a cc_library
// compile-checks them against `fixtures/author.h`.  If any
// emitter regresses on any type row, the build fails here.
//
// All decls use the `@component.<fn>` prefix — kForeignComponent
// is the only foreign-fn backend the celfn IDL exposes.

// Scalars (m24 §6 rows 1-5).
bool   @component.fn_bool(bool x);
int    @component.fn_int(int x);
uint   @component.fn_uint(uint x);
double @component.fn_double(double x);
null   @component.fn_null(null x);

// Variable-length scalars (m24 §6 rows 6-7).
string @component.fn_string(string x);
bytes  @component.fn_bytes(bytes x);

// Records (m24 §6 rows 8-9).  Capitalised per IDL grammar.
Duration  @component.fn_duration(Duration x);
Timestamp @component.fn_timestamp(Timestamp x);

// Aggregates (m24 §6 rows 10-11).  list and map.
list<int>          @component.fn_list_int(list<int> x);
list<string>       @component.fn_list_string(list<string> x);
map<string,int>    @component.fn_map_string_int(map<string,int> x);
map<int,bytes>     @component.fn_map_int_bytes(map<int,bytes> x);

// Nested aggregates — concrete-expansion recursion (m24 §6 / §A).
list<list<int>>                              @component.fn_nested_ll(list<list<int>> x);
list<map<string,list<int>>>                  @component.fn_nested_lml(list<map<string,list<int>>> x);
map<string,list<map<string,int>>>            @component.fn_nested_mlm(map<string,list<map<string,int>>> x);

// Mixed multi-param decls — argument-order + naming consistency.
int    @component.add(int a, int b);
string @component.greet(string name, list<string> roles);

// Proto rows (m24 §6 row 12) — kForeignComponent admits proto(...)
// per m24 §8; they cross the CM boundary as serialized bytes.
proto(acme.User)        @component.fn_proto(proto(acme.User) x);
proto(acme.User)        @component.fn_proto_to_struct(string name);
list<proto(acme.User)>  @component.fn_list_proto(list<proto(acme.User)> xs);
