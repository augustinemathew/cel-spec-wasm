# `cel generate` emitter libraries — see m26 §7.
#
# These libraries take a parsed FunctionLibrary (kForeignComponent
# decls) and emit one of the four output files
# (fns.wit / codec.h / generated_stub.cc / user_fns.h) per language
# target (C++ for now; Go arrives with H.4).  They are pure
# functions: in → text, no I/O.  The cc_binary that ties them to a
# CLI lives at `//tools/cel:cel`.
#
# The codec compile-check (codec_compile_check + genrule-emitted
# generated_codec.h) is the per-build gate per user direction at
# m26 §3.5 design time: when the codec generator changes, the
# bazel build itself fails if the emitted text isn't valid C++.

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//:internal"])

cc_library(
    name = "wit_emitter",
    srcs = ["wit_emitter.cc"],
    hdrs = ["wit_emitter.h"],
    deps = [
        "//compiler/celfn:function_library",
        "@com_google_absl//absl/base:nullability",
        "@com_google_absl//absl/log:absl_check",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
    ],
)

cc_library(
    name = "cpp_skeleton_emitter",
    srcs = ["cpp_skeleton_emitter.cc"],
    hdrs = ["cpp_skeleton_emitter.h"],
    deps = [
        ":cpp_stub_emitter",  # for SnakeToCamel
        "//compiler/celfn:function_library",
        "@com_google_absl//absl/base:nullability",
        "@com_google_absl//absl/log:absl_check",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
    ],
)

cc_test(
    name = "cpp_skeleton_emitter_test",
    srcs = ["cpp_skeleton_emitter_test.cc"],
    deps = [
        ":cpp_skeleton_emitter",
        "//compiler/celfn:function_library",
        "@com_google_absl//absl/log:absl_check",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:status_matchers",
        "@com_google_absl//absl/strings",
        "@com_google_googletest//:gtest_main",
    ],
)

cc_library(
    name = "cpp_stub_emitter",
    srcs = ["cpp_stub_emitter.cc"],
    hdrs = ["cpp_stub_emitter.h"],
    deps = [
        "//compiler/celfn:function_library",
        "@com_google_absl//absl/base:nullability",
        "@com_google_absl//absl/log:absl_check",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
    ],
)

cc_test(
    name = "cpp_stub_emitter_test",
    srcs = ["cpp_stub_emitter_test.cc"],
    deps = [
        ":cpp_stub_emitter",
        "//compiler/celfn:function_library",
        "@com_google_absl//absl/log:absl_check",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:status_matchers",
        "@com_google_absl//absl/strings",
        "@com_google_googletest//:gtest_main",
    ],
)

cc_library(
    name = "cpp_codec_emitter",
    srcs = ["cpp_codec_emitter.cc"],
    hdrs = ["cpp_codec_emitter.h"],
    deps = [
        "//compiler/celfn:function_library",
        "@com_google_absl//absl/base:nullability",
        "@com_google_absl//absl/log:absl_check",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
