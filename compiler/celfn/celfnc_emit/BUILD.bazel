# Tool that emits a sample codec.h driven by a fixed FunctionLibrary
# covering every type-row the emitter currently handles.  Consumed by
# the genrule below.
cc_binary(
    name = "codec_dumper",
    srcs = ["codec_dumper.cc"],
    deps = [
        ":cpp_codec_emitter",
        "//compiler/celfn:function_library",
        "@com_google_absl//absl/log:absl_check",
    ],
)

# Genrule that captures the dumper output as a header file consumed
# by codec_compile_check.  When the codec emitter regresses, the
# header is malformed and the compile-check cc_library below fails
# to build — surfacing the regression at bazel build time, not at
# the next downstream consumer (real cel_wasm_component invocations
# from end users).
genrule(
    name = "generated_codec_h",
    outs = ["generated_codec.h"],
    cmd = "$(location :codec_dumper) > $@",
    tools = [":codec_dumper"],
)

# Per-build gate (user direction, m26 §3.5 design): the genrule-
# emitted codec.h is compiled against the hand-curated author_stub.h
# (which mirrors real wit-bindgen output, §3.5.1).  Failing to
# compile == regression in the codec emitter.
cc_library(
    name = "codec_compile_check",
    srcs = ["fixtures/codec_compile_check.cc"],
    hdrs = [
        "fixtures/author.h",
        "generated_codec.h",
    ],
    # The generated codec.h `#include "author.h"` — strip the
    # fixtures/ prefix so the short name resolves.  Lives alongside
    # the genrule output, not in a separate include dir.
    includes = ["fixtures"],
    deps = [
        "@com_google_absl//absl/time",
    ],
)

cc_test(
    name = "wit_emitter_test",
    srcs = ["wit_emitter_test.cc"],
    deps = [
        ":wit_emitter",
        "//compiler/celfn:function_library",
        "@com_google_absl//absl/log:absl_check",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:status_matchers",
        "@com_google_absl//absl/strings",
        "@com_google_googletest//:gtest_main",
    ],
)
