load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = ["//compiler:__subpackages__"])

# Shared fixture lifted from `compiler/e2e/eval_test.cc`: compiles an
# expression end-to-end and exposes the decoding helpers the benches
# reuse for string / bytes / message results.  The cc_library keeps the
# bench binaries from duplicating the Precompile boilerplate.
cc_library(
    name = "bench_fixture",
    srcs = ["bench_fixture.cc"],
    hdrs = ["bench_fixture.h"],
    deps = [
        "//compiler/codegen:expr_lower",
        "//compiler/codegen:module",
        "//compiler/frontend:parse_and_check",
        "//compiler/host:host_loader",
        "//compiler/runtime:cel_runtime",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_protobuf//:protobuf",
        "@wasmtime_darwin_arm64//:wasmtime",
    ],
)

# Eval-path benchmarks: ParseAndCheck + Lower + Serialize + LoadEval run
# once per fixture; `CallEval` is what the `for (auto _ : state)` loop
# measures.  Run with `bazel run -c opt //compiler/bench:eval_bench`.
cc_binary(
    name = "eval_bench",
    srcs = ["eval_bench.cc"],
    deps = [
        ":bench_fixture",
        "//compiler/host:host_loader",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_benchmark//:benchmark_main",
        "@wasmtime_darwin_arm64//:wasmtime",
    ],
)

# Compile-path benchmarks: measures ParseAndCheck + Lower + Serialize +
# LoadEval as one unit.  Does not invoke `eval` at all.
cc_binary(
    name = "compile_bench",
    srcs = ["compile_bench.cc"],
    deps = [
        ":bench_fixture",
        "//compiler/host:host_loader",
        "//compiler/testdata:e2e_fixture_cc_proto",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_benchmark//:benchmark_main",
        "@wasmtime_darwin_arm64//:wasmtime",
    ],
)

# Proto-path benchmarks: field reads, message equality, has() against
# the `Customer` e2e fixture.  Externref args are rebuilt inside the
# measurement loop because `wasmtime_externref_new` takes the store;
# costs are small compared to CallEval.
cc_binary(
    name = "proto_bench",
    srcs = ["proto_bench.cc"],
    deps = [
        ":bench_fixture",
        "//compiler/host:host_loader",
        "//compiler/testdata:e2e_fixture_cc_proto",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_benchmark//:benchmark_main",
        "@wasmtime_darwin_arm64//:wasmtime",
    ],
)
