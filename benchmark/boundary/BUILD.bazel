load("@rules_cc//cc:defs.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])

# Wasm↔host call-boundary microbenches: the same logical call through
# wasmtime's boxed vs unchecked ABIs, both directions.  Quantifies the
# ceiling on the "typed/unchecked wasmtime calls" optimization
# candidate (benchmark/ANALYSIS.md P0/P5) before any production glue
# changes, and stays afterwards as the regression pin for the
# boundary cost.
#
# `manual`-tagged; run explicitly, always -c opt:
#   bazel run -c opt //benchmark/boundary:wasmtime_call_bench
cc_binary(
    name = "wasmtime_call_bench",
    srcs = ["wasmtime_call_bench.cc"],
    copts = ["-std=c++17"],
    tags = ["manual"],
    deps = [
        "//third_party/wasmtime",
        "@com_google_absl//absl/log:absl_check",
        "@com_google_absl//absl/strings",
        "@com_google_benchmark//:benchmark",
    ],
)

# Host-side proto field-read cost breakdown (no wasm boundary): cracks
# open the ~26 ns host work inside each cel_get_field crossing —
# descriptor lookup (cached in prod), reflection Get, CelValue encode.
#   bazel run -c opt //benchmark/boundary:proto_read_bench
cc_binary(
    name = "proto_read_bench",
    srcs = ["proto_read_bench.cc"],
    copts = ["-std=c++17"],
    tags = ["manual"],
    deps = [
        "//testdata:e2e_fixture_cc_proto",
        "@com_google_benchmark//:benchmark",
        "@com_google_protobuf//:protobuf",
    ],
)
