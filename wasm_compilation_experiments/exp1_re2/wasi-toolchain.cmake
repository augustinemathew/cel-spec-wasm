set(CMAKE_SYSTEM_NAME WASI)
set(CMAKE_SYSTEM_PROCESSOR wasm32)
set(WASI_SDK_PREFIX /Users/augustine/cel-spec-wasm/wasm_compilation_experiments/exp1_re2/wasi-sdk-25.0-arm64-macos)
set(CMAKE_C_COMPILER ${WASI_SDK_PREFIX}/bin/clang)
set(CMAKE_CXX_COMPILER ${WASI_SDK_PREFIX}/bin/clang++)
set(CMAKE_AR ${WASI_SDK_PREFIX}/bin/llvm-ar)
set(CMAKE_RANLIB ${WASI_SDK_PREFIX}/bin/llvm-ranlib)
set(CMAKE_SYSROOT ${WASI_SDK_PREFIX}/share/wasi-sysroot)
# Use the threads variant — std::mutex / std::thread available.
set(CMAKE_C_COMPILER_TARGET wasm32-wasi-threads)
set(CMAKE_CXX_COMPILER_TARGET wasm32-wasi-threads)
set(CMAKE_C_FLAGS_INIT "-Oz -pthread -D_WASI_EMULATED_SIGNAL -D_WASI_EMULATED_PROCESS_CLOCKS -D_WASI_EMULATED_MMAN -D_WASI_EMULATED_GETPID")
set(CMAKE_CXX_FLAGS_INIT "-Oz -fno-rtti -pthread -D_WASI_EMULATED_SIGNAL -D_WASI_EMULATED_PROCESS_CLOCKS -D_WASI_EMULATED_MMAN -D_WASI_EMULATED_GETPID")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-Wl,--shared-memory -Wl,--max-memory=67108864 -lwasi-emulated-signal -lwasi-emulated-process-clocks -lwasi-emulated-mman -lwasi-emulated-getpid")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
