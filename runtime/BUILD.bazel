# Phase C — wasm32-wasi-threads cross-compile via the `//third_party/
# wasi_sdk:wasm32_wasi` cc_toolchain.  Replaces the legacy genrule
# (which invoked wasi-sdk clang directly).  Built under the wasm
# platform via `wasm_cc_binary`, which transitions the configuration
# at the edge so downstream native consumers (the bytes-embed genrule
# below) can depend on it without flipping `--platforms` themselves.
#
# Per `doc/implementation-plan/rewrite/wasi/DESIGN.md` §3 + the
# Phase C plan, the runtime OWNS its memory and exports it; the
# expr module imports `cel.memory` from the runtime instance at
# link time.  Bytes [0, 262144) are reserved via
# `-Wl,--global-base=262144` for the expr module's active data
# segments (256 KiB — holds large materialized const aggregates; m31).
#
# The target uses `wasm32-wasi-threads` because the toolchain
# (which links absl + RE2 in Phase C) needs `<mutex>` for cctz.
# Pure-C kernels don't actually use threading primitives —
# `wasm-ld` dead-strips unused wasi imports — so this costs
# nothing here.  See `rewrite/phase-c-plan.md` §7.2.
cc_binary(
    name = "cel_runtime_wasm.bin",
    srcs = [
        "cel_3vl.c",
        "cel_3vl.h",
        "cel_arena.c",
        "cel_arena.h",
        "cel_arith.c",
        "cel_arith.h",
        "cel_compare.c",
        "cel_compare.h",
        "cel_convert.c",
        "cel_convert.h",
        "cel_convert_double_format.cc",
        "cel_data.h",
        "cel_internal.h",
        "cel_layout.h",
        "cel_list.h",
        "cel_log.c",
        "cel_log.h",
        "cel_make.c",
        "cel_make.h",
        "cel_map.h",
        "cel_memory.c",
        "cel_memory.h",
        "cel_net_ext.c",
        "cel_net_ext.h",
        "cel_runtime.c",
        "cel_runtime.h",
        "cel_string_ops.c",
        "cel_string_ops.h",
        "cel_time.c",
        "cel_time.h",
        "cel_type.c",
        "cel_type.h",
    ],
    additional_linker_inputs = [
        "wasm_imports.txt",
        ":wasm_export_args",
    ],
    copts = [
        # `__attribute__((musttail))` requires the wasm tail-call
        # feature to lower as `return_call`.  Without `-mtail-call`
        # clang errors out rather than silently downgrading — that's
        # the point.  wasmtime config also gets the matching flag in
        # api/engine.cc.
        "-mtail-call",
        # Per-target warnings beyond toolchain's `-Wall`.
        "-Wextra",
        "-Wno-unused-parameter",
        # LTO so the linker can inline kind-check helpers (e.g.
        # `cel_int_eq_at_vv`) into hot loops like `cel_list_in`'s
        # scan — the asymmetry to the native `cc_library` above
        # (which already sets -O3 -flto) was a measured perf
        # ceiling for the `in`-list bench.  Matches the native side.
        "-flto",
    ] + select({
        ":opt_mode": ["-DCEL_LOG_DISABLED"],
        "//conditions:default": [],
    }),
    linkopts = [
        # No standard startup files; runtime is library code, no main.
        "-nostartfiles",
        "-Wl,--no-entry",
        # Match the -flto in copts; without this the linker can't
        # see the LTO bitcode and falls back to per-TU object code.
        "-flto",
        # Reserve [0, 262144) for the expr module's active data segments
        # (256 KiB — holds rodata + workspace + materialized const
        # aggregates).  Per DESIGN.md §3 / experiments/exp_a_rodata.c.
        "-Wl,--global-base=262144",
        # Tight import allowlist.  The toolchain's default link flags
        # include the broader `-Wl,--allow-undefined`; this file-based
        # form is documented for the day the toolchain feature is
        # split out so per-target strict mode is opt-in.
        "-Wl,--allow-undefined-file=$(location wasm_imports.txt)",
        # Runtime owns and exports its memory.  By default
        # wasi-sdk's wasm-ld exports the module-defined memory as
        # `memory`; the host pulls it off `runtime_instance` after
        # instantiation, then binds it on the linker as `cel.memory`
        # so the expr module (which still imports `cel.memory`)
        # resolves to the same backing store.
        # Export list (195 symbols) comes from `wasm_exports.txt`
        # via the `:wasm_export_args` genrule which emits one
        # `--export=<name>` per line into a wasm-ld response file
        # consumed below by `-Wl,@<file>`.  See the file header for
        # the single-source-of-truth refactor rationale.
        "-Wl,@$(location :wasm_export_args)",
    ],
    tags = ["manual"],
    deps = [
        ":cel_base64_ext",
        ":cel_matches",
        ":cel_string_ext",
        ":cel_string_format",
        ":cel_time_parse",
    ],
)

# Cross-platform-transition wrapper around the cc_binary above so
# native-host consumers (the bytes-embed genrule, host-side tests)
# can `srcs = [":cel_runtime_wasm"]` without flipping `--platforms`.
wasm_cc_binary(
    name = "cel_runtime_wasm",
    binary = ":cel_runtime_wasm.bin",
    tags = ["manual"],
)

genrule(
    name = "cel_runtime_wasm_bytes_cc",
    srcs = [":cel_runtime_wasm"],
    outs = ["cel_runtime_wasm_bytes.cc"],
    cmd = """
set -e
src=$(location :cel_runtime_wasm)
{
  echo '// Auto-generated by //runtime:cel_runtime_wasm_bytes_cc.'
  echo '// Do not edit by hand; re-run the genrule to refresh.'
  echo '#include "runtime/cel_runtime_wasm_bytes.h"'
  echo
  echo 'namespace celwasm {'
  echo
  echo 'const unsigned char kCelRuntimeWasmBytes[] = {'
  od -An -tu1 -v "$$src" | awk '{ for (i=1;i<=NF;i++) printf "0x%02x,", $$i; print "" }'
  echo '};'
  echo 'const unsigned int kCelRuntimeWasmBytesSize = sizeof(kCelRuntimeWasmBytes);'
  echo
  echo '}  // namespace celwasm'
} > $@
""",
    tags = ["manual"],
)

cc_library(
    name = "cel_runtime_wasm_bytes",
    srcs = [":cel_runtime_wasm_bytes_cc"],
    hdrs = ["cel_runtime_wasm_bytes.h"],
    tags = ["manual"],
)

# m28 configurable linking — static-link variant of the runtime.
#
# Three steps:
#   1. `strip_command_wrappers` (cc_binary, native host) — Binaryen-based
#      tool that retargets every `X.command_export` wrapper export to the
#      bare body `X` and DCEs the now-unreachable wrappers + ctor/dtor chain.
#   2. `cel_runtime_stripped_wasm.bin` (genrule) — runs the tool on the
#      already-built `cel_runtime_wasm.bin`.
#   3. `cel_runtime_stripped_wasm_bytes` (cc_library) — embeds the
#      resulting bytes as a `const unsigned char[]` parallel to
#      `cel_runtime_wasm_bytes`.  Consumed by the compiler at static-mode
#      `Compile()` time.
#
# See `doc/implementation-plan/rewrite/m28-configurable-linking.md` §5.2
# for the rationale (toolchain spike showed neither reactor mode nor a
# vanilla-wasi target can produce this artifact from clang alone).

cc_binary(
    name = "strip_command_wrappers",
    srcs = ["strip_command_wrappers.cc"],
    deps = [
        "@binaryen//:binaryen",
    ],
)

genrule(
    name = "cel_runtime_stripped_wasm_bin",
    srcs = [":cel_runtime_wasm"],
    outs = ["cel_runtime_stripped_wasm.bin"],
    cmd = "$(location :strip_command_wrappers) $(location :cel_runtime_wasm) $@",
    tools = [":strip_command_wrappers"],
    tags = ["manual"],
)

genrule(
    name = "cel_runtime_stripped_wasm_bytes_cc",
    srcs = [":cel_runtime_stripped_wasm_bin"],
    outs = ["cel_runtime_stripped_wasm_bytes.cc"],
    cmd = """
set -e
src=$(location :cel_runtime_stripped_wasm_bin)
{
  echo '// Auto-generated by //runtime:cel_runtime_stripped_wasm_bytes_cc.'
  echo '// Do not edit by hand; re-run the genrule to refresh.'
  echo '#include "runtime/cel_runtime_stripped_wasm_bytes.h"'
  echo
  echo 'namespace celwasm {'
  echo
  echo 'const unsigned char kCelRuntimeStrippedWasmBytes[] = {'
  od -An -tu1 -v "$$src" | awk '{ for (i=1;i<=NF;i++) printf "0x%02x,", $$i; print "" }'
  echo '};'
  echo 'const unsigned int kCelRuntimeStrippedWasmBytesSize = sizeof(kCelRuntimeStrippedWasmBytes);'
  echo
  echo '}  // namespace celwasm'
} > $@
""",
    tags = ["manual"],
)

cc_library(
    name = "cel_runtime_stripped_wasm_bytes",
    srcs = [":cel_runtime_stripped_wasm_bytes_cc"],
    hdrs = ["cel_runtime_stripped_wasm_bytes.h"],
    tags = ["manual"],
)

# Verifies the embedded stripped bytes are well-formed wasm and contain
# no `.command_export` wrappers — the load-bearing invariant of the
# strip tool.  Compares against the original cel_runtime_wasm_bytes to
# ensure the strip actually shrunk the artifact.
cc_test(
    name = "cel_runtime_stripped_wasm_bytes_test",
    size = "small",
    srcs = ["cel_runtime_stripped_wasm_bytes_test.cc"],
    tags = ["manual"],
    deps = [
        ":cel_runtime_stripped_wasm_bytes",
        ":cel_runtime_wasm_bytes",
        "//abi:runtime_catalogue",
        "@binaryen//:binaryen",
        "@com_google_googletest//:gtest_main",
    ],
)
