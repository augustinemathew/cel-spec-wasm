load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//third_party/wasi_sdk:wasm_cc_binary.bzl", "wasm_cc_binary")

package(default_visibility = ["//visibility:public"])

# `wasm_exports.txt` is the canonical list of symbols
# `cel_runtime.wasm` exports.  Two consumers below:
#
#   1. `wasm_export_args` genrule — converts the text file to a
#      wasm-ld response file (one `--export=<name>` per line).
#      `cel_runtime_wasm.bin` picks it up via `-Wl,@<rsp>`.
#   2. `//abi:runtime_catalogue_consistency_test` —
#      reads the text file at test time and asserts the
#      `[codegen-helpers]` section is identical to
#      `celwasm::abi::CelRuntimeHelpers()`.
#
# Exported as a plain file so the test (in `//abi`)
# can `data = ["//runtime:wasm_exports.txt"]` it.
exports_files(
    ["wasm_exports.txt"],
    visibility = ["//abi:__subpackages__"],
)

# The runtime C sources — the single source of truth for the
# codegen-helper export set.  Each codegen-imported helper is marked at
# its declaration with `// cel:codegen-export`; `//bazel:gen_runtime_catalogue`
# reads the markers (membership) plus the `void`/`uint32_t` signature
# (arity + return shape, which clang lowers one-to-one to the wasm
# function type).  Consumed below by `codegen_export_names` and by
# `//abi:runtime_catalogue_textproto`.
filegroup(
    name = "runtime_c_sources",
    srcs = glob([
        "cel_*.h",
        "cel_*.c",
    ]),
    visibility = ["//abi:__subpackages__"],
)

# The codegen-helper export names, derived from the C markers.  One bare
# symbol per line, in source order.  UNIONed with `wasm_exports.txt`'s
# host-only list to form the linker `--export=` set.
genrule(
    name = "codegen_export_names",
    srcs = [":runtime_c_sources"],
    outs = ["codegen_export_names.txt"],
    cmd = "$(location //bazel:gen_runtime_catalogue) --mode names " +
          "--out $@ $(locations :runtime_c_sources)",
    tools = ["//bazel:gen_runtime_catalogue"],
    visibility = ["//abi:__subpackages__"],
)

# Build the wasm-ld response file: one `--export=<name>` per symbol.
# The export set is the UNION of the generated codegen-helper names and
# the hand-maintained host-only list in `wasm_exports.txt` (system /
# linker-internal symbols, the public arena reentry API, and the
# same-kind eq/ne + `_arena` tail-call targets).  Consumed by
# `cel_runtime_wasm.bin`'s linkopts via `-Wl,@$(location ...)`.
#
# For `wasm_exports.txt` we strip section headers (`[name]`), comments
# (`#...`), and blanks, keeping the first whitespace token of each
# remaining line.  `awk` is on every bazel-supported host; no extra dep.
genrule(
    name = "wasm_export_args",
    srcs = [
        "wasm_exports.txt",
        ":codegen_export_names",
    ],
    outs = ["wasm_export_args.rsp"],
    cmd = """
{
  awk '
    /^[[:space:]]*#/    { next }
    /^[[:space:]]*$$/   { next }
    /^[[:space:]]*\\[/  { next }
    { print "--export=" $$1 }
  ' $(location wasm_exports.txt)
  awk '{ print "--export=" $$1 }' $(location :codegen_export_names)
} > $@
""",
)

# Gates the `-DCEL_LOG_DISABLED` define on -c opt builds.  Every public
# runtime helper does a `CEL_LOG("enter")` host trampoline that
# `fprintf`s to stderr.  Useful for the dead-code audit (see
# `cel_log.h`); fatal to per-Eval performance once kernels start
# stacking.  Keep CEL_LOG live for dbg/fastbuild; disable it for opt
# benches + opt-built deploys.  Baseline accounting:
# doc/implementation-plan/rewrite/archive/bench-tree-readme.md.
config_setting(
    name = "opt_mode",
    values = {"compilation_mode": "opt"},
)

# Header-only target for the layout constants.  Exposed separately
# from the full `cel_runtime` because the compile-time
# `compiler/memory_layout.h` needs the same numbers via
# `static_assert` parity checks, and pulling in all of the runtime's
# .c files just for the macros would create an unwanted dep graph.
cc_library(
    name = "cel_layout",
    hdrs = ["cel_layout.h"],
    visibility = ["//:internal"],
)

# Native-host build of the runtime.  Used by unit tests and by host-side
# code that needs the CelValue layout (codegen, cel_log, tests).
cc_library(
    name = "cel_runtime",
    srcs = [
        "cel_3vl.c",
        "cel_arena.c",
        "cel_arith.c",
        "cel_compare.c",
        "cel_convert.c",
        "cel_internal.h",
        "cel_log.c",
        "cel_make.c",
        "cel_math_ext.c",
        "cel_memory.c",
        "cel_net_ext.c",
        "cel_optional.c",
        "cel_runtime.c",
        "cel_string_ops.c",
        "cel_time.c",
        "cel_type.c",
    ],
    hdrs = [
        "cel_3vl.h",
        "cel_arena.h",
        "cel_arith.h",
        "cel_compare.h",
        "cel_convert.h",
        "cel_data.h",
        "cel_layout.h",
        "cel_list.h",
        "cel_log.h",
        "cel_make.h",
        "cel_map.h",
        "cel_math_ext.h",
        "cel_memory.h",
        "cel_net_ext.h",
        "cel_optional.h",
        "cel_runtime.h",
        "cel_string_ops.h",
        "cel_time.h",
        "cel_type.h",
    ],
    copts = [
        "-std=c11",
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
        # Speed knobs.  -O3 + -flto let the linker inline across the
        # per-topic .c files split out by `cel-runtime-c-split-plan.md`.
        # The static-inline helpers in cel_internal.h (`poison` /
        # `absorb_3vl_*` / `write_*` / `require_kinds`) already inline at
        # -O2; -O3 widens aggressiveness on vectorisable inner loops
        # (`utf8_valid`, `write_uint_decimal`, parse loops), and LTO
        # lets `cel_int_add_at_vv` inline its kind-check into call
        # sites in `cel_arith.c` callers across TU boundaries.
        "-O3",
        "-flto",
    ] + select({
        ":opt_mode": ["-DCEL_LOG_DISABLED"],
        "//conditions:default": [],
    }),
    linkopts = [
        "-flto",
    ],
)

# `cel_convert_double_format`: `cel_double_to_string_at_v`, carved out
# of the umbrella C runtime into a sibling C++ TU so it can use
# `std::to_chars(double, chars_format::general)` from libc++ — the
# shortest-round-trip formatter cel-cpp uses
# (`runtime/standard/type_conversion_functions.cc:56`).  The hand-
# rolled C path that lived in `cel_convert.c` accumulated rounding
# error past ~6 fractional digits and produced
# `"123.45600000000000306"` for `string(123.456)`; the to_chars rewrite
# fixes that corpus row.
#
# `alwayslink = True` because this TU only defines `extern "C"` symbols
# (no headers, no static-init); without it the linker can drop the
# object when its symbols look "unused" at link time but are actually
# referenced via the wasm runtime catalogue.
cc_library(
    name = "cel_convert_double_format",
    srcs = ["cel_convert_double_format.cc"],
    copts = [
        "-Wno-unused-parameter",
    ],
    alwayslink = True,
    deps = [
        ":cel_runtime",
    ],
)

