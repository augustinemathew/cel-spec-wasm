module(
    name = "cel-spec",
)

bazel_dep(
    name = "bazel_skylib",
    version = "1.7.1",
)
bazel_dep(
    name = "gazelle",
    version = "0.39.1",
    repo_name = "bazel_gazelle",
)
bazel_dep(
    name = "protobuf",
    version = "33.4",
    repo_name = "com_google_protobuf",
)
bazel_dep(
    name = "rules_cc",
    version = "0.0.17",
)
bazel_dep(
    name = "rules_foreign_cc",
    version = "0.15.1",
)

# Binaryen — vendored as a pinned GitHub release tarball and built via
# its own CMakeLists.txt inside Bazel (rules_foreign_cc).  We consume
# the officially stable C API (`binaryen-c.h` + `libbinaryen.a`).
http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)
http_archive(
    name = "binaryen",
    build_file = "//third_party/binaryen:BUILD.external.bazel",
    sha256 = "0bbfc0f414a18235f47a3e13a333cc14f702ab3324fb10653ab08865680fcbb8",
    strip_prefix = "binaryen-version_129",
    urls = [
        "https://github.com/WebAssembly/binaryen/archive/refs/tags/version_129.tar.gz",
    ],
)

# wasmtime — prebuilt C API release tarball used only by the e2e
# eval test (instantiates a compiler-emitted .wasm module and checks
# the call returns the expected literal).  We pin the darwin-arm64
# tarball because that's the only platform this repo currently builds
# on (see CLAUDE.md); other platforms can gain a matching archive when
# they're brought online.  libwasmtime.a is the ~30 MiB static lib.
http_archive(
    name = "wasmtime_darwin_arm64",
    build_file = "//third_party/wasmtime:BUILD.external.bazel",
    sha256 = "6e5c423f69d50d2c3fd6ad6a5e0953c299a4db1eae27fb727bf7b6f4f83d51ce",
    strip_prefix = "wasmtime-v43.0.1-aarch64-macos-c-api",
    urls = [
        "https://github.com/bytecodealliance/wasmtime/releases/download/v43.0.1/wasmtime-v43.0.1-aarch64-macos-c-api.tar.xz",
    ],
)

# C++ CEL compiler dependencies.
bazel_dep(
    name = "abseil-cpp",
    version = "20260107.0",
    repo_name = "com_google_absl",
)
bazel_dep(
    name = "cel-cpp",
    version = "0.0.0",
)
local_path_override(
    module_name = "cel-cpp",
    path = "third_party/cel-cpp",
)
bazel_dep(
