# WASI preview1 → preview2 reactor adapter — required by
# `wasm-tools component new` to wrap a wasm32-wasi core module (which
# imports `wasi_snapshot_preview1::*` syscalls via the wasi-sdk libc)
# into a Component-Model component (which speaks wasi-preview2 only).
# Shipped as a single ~51 KiB `.wasm` per wasmtime release; one
# adapter binary works across all build hosts.  Consumed by the
# `cel_wasm_plugin` Starlark macro at //bazel:cel_wasm_plugin.bzl.
http_file = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_file",
)
http_file(
    name = "wasi_preview1_adapter",
    sha256 = "bd558cd2c428665a69ef0833d49ae98ee42fe6d51b5b091fc6f847e9a17cb228",
    urls = ["https://github.com/bytecodealliance/wasmtime/releases/download/v43.0.1/wasi_snapshot_preview1.reactor.wasm"],
    downloaded_file_path = "wasi_snapshot_preview1.reactor.wasm",
)

# C++ CEL compiler dependencies.
bazel_dep(
    name = "abseil-cpp",
    version = "20260107.0",
    repo_name = "com_google_absl",
)

bazel_dep(
    name = "cel-cpp",
    version = "0.0.0",
)
local_path_override(
    module_name = "cel-cpp",
    path = "third_party/cel-cpp",
)

# M13 Slice B — ANTLR4 for the `.celfn` IDL parser.  Mirrors how
# cel-cpp loads ANTLR (third_party/cel-cpp/MODULE.bazel §"ANTLR4"):
# the C++ runtime is a bazel module, the code-generator jar is an
# http_jar.  Versions pinned to match cel-cpp's so we don't end up
# with two ANTLR4 toolchains in the build graph.
ANTLR4_VERSION = "4.13.2"

bazel_dep(
    name = "antlr4-cpp-runtime",
    version = ANTLR4_VERSION,
)
single_version_override(
    module_name = "antlr4-cpp-runtime",
    # Same patch cel-cpp applies (third_party/cel-cpp/bazel/antlr.patch);
    # vendored locally because bazel module overrides only honor patches
    # from the root module.
    patches = ["//third_party/patches:antlr-cpp-runtime.patch"],
)

http_jar = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_jar")
http_jar(
    name = "antlr4_jar",
    sha256 = "eae2dfa119a64327444672aff63e9ec35a20180dc5b8090b7a6ab85125df4d76",
    urls = ["https://www.antlr.org/download/antlr-" + ANTLR4_VERSION + "-complete.jar"],
)
bazel_dep(
    name = "googletest",
    version = "1.17.0.bcr.2",
    repo_name = "com_google_googletest",
)
bazel_dep(
    name = "google_benchmark",
    version = "1.9.1",
    repo_name = "com_google_benchmark",
)

# yaml-cpp — YAML parser for the benchmark corpus loader
# (//benchmark/eval:corpus_loader).  The corpus YAMLs under
# benchmark/eval/corpus/ describe each cell (id, source expression,
# activation, expected value, tags); the loader parses + validates
# them at bench-binary startup.
bazel_dep(
    name = "yaml-cpp",
    version = "0.8.0.bcr.1",
)

# FuzzTest — Google's property-based / coverage-guided fuzzing
# framework, built on top of googletest.  Test bodies are written as
# `FUZZ_TEST(Suite, Name)` over typed properties; in unit-test mode
# (`bazel test`) FuzzTest runs ~1000 randomised iterations of each
# property and reports failures through gtest.  In fuzzing mode
# (`bazel run --config=fuzztest`) the same binary turns into a
# coverage-guided fuzzer.  Transitive deps (abseil-cpp, re2,
# googletest, protobuf, antlr4-cpp-runtime, platforms) are already
# declared above; bzlmod's resolver merges them.
bazel_dep(
    name = "fuzztest",
    version = "20260219.0",
)
bazel_dep(
    name = "rules_java",
    version = "7.6.5",
)
bazel_dep(
    name = "rules_proto",
    version = "7.0.2",
)
bazel_dep(
    name = "rules_python",
    version = "0.35.0",
)

### PYTHON ###
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    ignore_root_user_error = True,
    python_version = "3.11",
)
