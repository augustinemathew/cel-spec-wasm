# cel-wasm — an ahead-of-time compiler from the Common Expression Language (CEL)
# to WebAssembly.  Compiles a CEL expression into a self-contained wasm module
# plus a `cel.abi` contract, then evaluates it against a host activation.
module(
    name = "cel-wasm",
)

# CEL protos (cel.expr.*) and the conformance corpus come from upstream cel-spec.
bazel_dep(
    name = "cel-spec",
    version = "0.25.1",
    repo_name = "com_google_cel_spec",
)

bazel_dep(
    name = "bazel_skylib",
    version = "1.7.1",
)
bazel_dep(
    name = "protobuf",
    version = "33.4",
    repo_name = "com_google_protobuf",
)
bazel_dep(
    name = "rules_cc",
    version = "0.0.17",
)
bazel_dep(
    name = "rules_foreign_cc",
    version = "0.15.1",
)

# Phase C probe E3 — required for the wasm32-wasi cc_toolchain
# (//doc/implementation-plan/rewrite/phase-c-probes/E3) to reference
# @platforms//cpu:wasm32 + @platforms//os:wasi as constraint values.
# This is the same `platforms` rule the bazel ecosystem expects; it
# was already a transitive dep of every existing bazel_dep but not
# visible from the main repo until declared here.
bazel_dep(
    name = "platforms",
    version = "1.0.0",
)

# Phase C probe E8 — RE2 for `matches()`.  Already a transitive
# dep of abseil-cpp / protobuf in the bazel module graph; this
# bazel_dep just makes it visible from the main repo so we can
# build it under the wasm32-wasi-threads cc_toolchain.
bazel_dep(
    name = "re2",
    version = "2025-11-05.bcr.1",
)

# Register the wasm32-wasi-threads cc_toolchains — one per build host
# (darwin/linux × arm64/x86_64).  Auto-discovered by bazel toolchain
# resolution whenever a target is built with
# `--platforms=//third_party/wasi_sdk:wasm32_wasi` (or transitioned in
# via `wasm_cc_binary`); resolution picks the toolchain whose
# `exec_compatible_with` matches the build host, so each host fetches
# only its own `@wasi_sdk_<host>` archive.  The toolchain configs +
# wrapper sh scripts live under `//third_party/wasi_sdk/`.
register_toolchains(
    "//third_party/wasi_sdk:wasm32_wasi_toolchain_darwin_arm64",
    "//third_party/wasi_sdk:wasm32_wasi_toolchain_darwin_x86_64",
    "//third_party/wasi_sdk:wasm32_wasi_toolchain_linux_arm64",
    "//third_party/wasi_sdk:wasm32_wasi_toolchain_linux_x86_64",
)

# Binaryen — vendored as a pinned GitHub release tarball and built via
# its own CMakeLists.txt inside Bazel (rules_foreign_cc).  We consume
# the officially stable C API (`binaryen-c.h` + `libbinaryen.a`).
http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)
http_archive(
    name = "binaryen",
    build_file = "//third_party/binaryen:BUILD.external.bazel",
    sha256 = "0bbfc0f414a18235f47a3e13a333cc14f702ab3324fb10653ab08865680fcbb8",
    strip_prefix = "binaryen-version_129",
    urls = [
        "https://github.com/WebAssembly/binaryen/archive/refs/tags/version_129.tar.gz",
    ],
)

# wasmtime — prebuilt C API release tarball used only by the e2e
# eval test (instantiates a compiler-emitted .wasm module and checks
# the call returns the expected literal).  One archive per build host
# (darwin/linux × arm64/x86_64); `//third_party/wasmtime:wasmtime`
# selects the matching one by build-host `@platforms//{os,cpu}`.
# libwasmtime.a is the ~30 MiB static lib.
http_archive(
    name = "wasmtime_darwin_arm64",
    build_file = "//third_party/wasmtime:BUILD.macos.bazel",
    sha256 = "6e5c423f69d50d2c3fd6ad6a5e0953c299a4db1eae27fb727bf7b6f4f83d51ce",
    strip_prefix = "wasmtime-v43.0.1-aarch64-macos-c-api",
    urls = [
        "https://github.com/bytecodealliance/wasmtime/releases/download/v43.0.1/wasmtime-v43.0.1-aarch64-macos-c-api.tar.xz",
    ],
)
http_archive(
    name = "wasmtime_linux_arm64",
    build_file = "//third_party/wasmtime:BUILD.linux.bazel",
    sha256 = "64670a608f50f8d3e5564590ebf49a1c1fa9dc778152d5b87cd7c4fa415029a9",
    strip_prefix = "wasmtime-v43.0.1-aarch64-linux-c-api",
    urls = [
        "https://github.com/bytecodealliance/wasmtime/releases/download/v43.0.1/wasmtime-v43.0.1-aarch64-linux-c-api.tar.xz",
    ],
)
http_archive(
    name = "wasmtime_linux_x86_64",
    build_file = "//third_party/wasmtime:BUILD.linux.bazel",
    sha256 = "794a65220cf8de8903c367c938d156b0f894be60aaff35c02329e09792ecf927",
    strip_prefix = "wasmtime-v43.0.1-x86_64-linux-c-api",
    urls = [
        "https://github.com/bytecodealliance/wasmtime/releases/download/v43.0.1/wasmtime-v43.0.1-x86_64-linux-c-api.tar.xz",
    ],
)

# wasi-sdk — wasm32-wasi cross-compile toolchain used to build
# cel_runtime.wasm.  Replaces the previous brew-llvm + freestanding-
# wasm32 build path.  Provides clang/clang++/llvm-ar/llvm-ranlib that
# target wasm32-wasi, plus a wasi-sysroot (libc + libc++ + the WASI
# preview1 headers).  Per the migration plan
# (doc/implementation-plan/wasi/DESIGN.md §3), we use the vanilla
# wasm32-wasi target (not the threads variant) — zero WASI imports
# are required by our pure-malloc kernels, which keeps the browser
# target story clean.
#
# Four per-platform archives are declared; `//third_party/wasi_sdk:`
# aliases dispatch to the right one based on
# @platforms//os × @platforms//cpu.  Each tarball is ~100 MB; bazel
# fetches lazily and caches.
http_archive(
    name = "wasi_sdk_darwin_arm64",
    build_file = "//third_party/wasi_sdk:BUILD.external.bazel",
    sha256 = "e1e529ea226b1db0b430327809deae9246b580fa3cae32d31c82dfe770233587",
    strip_prefix = "wasi-sdk-25.0-arm64-macos",
    urls = ["https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-25/wasi-sdk-25.0-arm64-macos.tar.gz"],
)
http_archive(
    name = "wasi_sdk_darwin_x86_64",
    build_file = "//third_party/wasi_sdk:BUILD.external.bazel",
    sha256 = "55e3ff3fee1a15678a16eeccba0129276c9f6be481bc9c283e7f9f65bf055c11",
    strip_prefix = "wasi-sdk-25.0-x86_64-macos",
    urls = ["https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-25/wasi-sdk-25.0-x86_64-macos.tar.gz"],
)
http_archive(
    name = "wasi_sdk_linux_arm64",
    build_file = "//third_party/wasi_sdk:BUILD.external.bazel",
    sha256 = "47fccad8b2498f2239e05e1115c3ffc652bf37e7de2f88fb64b2d663c976ce2d",
    strip_prefix = "wasi-sdk-25.0-arm64-linux",
    urls = ["https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-25/wasi-sdk-25.0-arm64-linux.tar.gz"],
)
http_archive(
    name = "wasi_sdk_linux_x86_64",
    build_file = "//third_party/wasi_sdk:BUILD.external.bazel",
    sha256 = "52640dde13599bf127a95499e61d6d640256119456d1af8897ab6725bcf3d89c",
    strip_prefix = "wasi-sdk-25.0-x86_64-linux",
    urls = ["https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-25/wasi-sdk-25.0-x86_64-linux.tar.gz"],
)

# C++ CEL compiler dependencies.
bazel_dep(
    name = "abseil-cpp",
    version = "20260107.0",
    repo_name = "com_google_absl",
)

# Phase C: patch abseil-cpp's sysinfo.cc so GetNumCPUs() compiles
# under wasm32-wasi (the non-threads variant has no <thread>).  The
# patch returns 1 on `__wasm__` / `__wasi__`.  Source patch lives at
# `wasm_compilation_experiments/exp1_re2/absl-wasm.patch` and was
# vendored to `third_party/patches/abseil-cpp-wasm-sysinfo.patch`
# during Phase C research.
single_version_override(
    module_name = "abseil-cpp",
    patch_strip = 1,
    patches = ["//third_party/patches:abseil-cpp-wasm-sysinfo.patch"],
)
bazel_dep(
    name = "cel-cpp",
    version = "0.0.0",
)
local_path_override(
    module_name = "cel-cpp",
    path = "third_party/cel-cpp",
)

# M13 Slice B — ANTLR4 for the `.celfn` IDL parser.  Mirrors how
# cel-cpp loads ANTLR (third_party/cel-cpp/MODULE.bazel §"ANTLR4"):
# the C++ runtime is a bazel module, the code-generator jar is an
# http_jar.  Versions pinned to match cel-cpp's so we don't end up
# with two ANTLR4 toolchains in the build graph.
ANTLR4_VERSION = "4.13.2"

bazel_dep(
    name = "antlr4-cpp-runtime",
    version = ANTLR4_VERSION,
)
single_version_override(
    module_name = "antlr4-cpp-runtime",
    # Same patch cel-cpp applies (third_party/cel-cpp/bazel/antlr.patch);
    # vendored locally because bazel module overrides only honor patches
    # from the root module.
    patches = ["//third_party/patches:antlr-cpp-runtime.patch"],
)

http_jar = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_jar")
http_jar(
    name = "antlr4_jar",
    sha256 = "eae2dfa119a64327444672aff63e9ec35a20180dc5b8090b7a6ab85125df4d76",
    urls = ["https://www.antlr.org/download/antlr-" + ANTLR4_VERSION + "-complete.jar"],
)
bazel_dep(
    name = "googletest",
    version = "1.17.0.bcr.2",
    repo_name = "com_google_googletest",
)
bazel_dep(
    name = "google_benchmark",
    version = "1.9.1",
    repo_name = "com_google_benchmark",
)

# yaml-cpp — YAML parser for the benchmark corpus loader
# (//benchmark/eval:corpus_loader).  The corpus YAMLs under
# benchmark/eval/corpus/ describe each cell (id, source expression,
# activation, expected value, tags); the loader parses + validates
# them at bench-binary startup.
bazel_dep(
    name = "yaml-cpp",
    version = "0.8.0.bcr.1",
)

bazel_dep(
    name = "rules_java",
    version = "7.6.5",
)
bazel_dep(
    name = "rules_proto",
    version = "7.0.2",
)
bazel_dep(
    name = "rules_python",
    version = "0.35.0",
)

### PYTHON ###
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    ignore_root_user_error = True,
    python_version = "3.11",
)
