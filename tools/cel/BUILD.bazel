# Smoke-test the binary end-to-end.  Proto-schema coverage is in
# the var_parser_test / value_format_test cc_tests (linked directly
# against the library code); this just verifies the binary parses
# argv + dispatches subcommands correctly.
sh_test(
    name = "cel_smoke_test",
    size = "large",
    srcs = ["cel_smoke_test.sh"],
    data = [
        ":cel",
        "//e2e/plugin_fixtures/cel_wasm_plugin_demo:demo_plugin.wasm",
        # A real FileDescriptorSet for the --descriptor_set rows; the
        # proto_library emits it as a by-product.
        "//testdata:e2e_fixture_proto",
    ],
)

# Activation-marshal coverage matrix — every aggregate kind passed
# in via `cel::Activation::Bind`.  Mirrors the user-facing CLI
# `--var name:Type=value` shape but drives the public C++ API
# directly (cleaner assertions, no shell-out).  See file header
# for the coverage axes.
cc_test(
    name = "activation_matrix_test",
    size = "large",
    srcs = ["activation_matrix_test.cc"],
    tags = ["manual"],
    deps = [
        "//testdata:e2e_fixture_cc_proto",
        "//testdata:host_fixture_proto3_cc_proto",
        "//eval:activation",
        "//eval:cel_host",
        "//compiler:compiler",
        "//eval:engine",
        "//eval:instance",
        "//compiler:program",
        "//shared:type",
        "//eval:value",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:status_matchers",
        "@com_google_googletest//:gtest_main",
    ],
)
