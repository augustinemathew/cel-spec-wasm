load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

# The taxonomy drift guard (//e2e:taxonomy_validate_test) reads this
# BUILD file to verify cli_workloads entries name real targets.
exports_files(["BUILD.bazel"])

package(default_visibility = ["//visibility:public"])

# `cel` command-line driver.  Subcommands: eval / check / compile.
# Schema-aware (--proto / --descriptor_set) and value-aware (--var
# name:Type=value) wrapper around the celwasm::Compile pipeline +
# cel::Engine runtime.

cc_library(
    name = "var_parser",
    srcs = ["var_parser.cc"],
    hdrs = ["var_parser.h"],
    deps = [
        "//shared:type",
        "//eval:value",
        "@com_google_absl//absl/base:core_headers",
        "@com_google_absl//absl/log:absl_check",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/time",
        "@com_google_protobuf//:protobuf",
    ],
)

cc_test(
    name = "var_parser_test",
    size = "small",
    srcs = ["var_parser_test.cc"],
    deps = [
        ":var_parser",
        "//testdata:e2e_fixture_cc_proto",
        "//eval:cel_host",
        "//shared:type",
        "//eval:value",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:status_matchers",
        "@com_google_absl//absl/strings",
        "@com_google_googletest//:gtest_main",
        "@com_google_protobuf//:protobuf",
    ],
)

