load("@rules_cc//cc:defs.bzl", "cc_binary")

package(default_visibility = ["//compiler_v2:__subpackages__"])

# Bench targets are `manual`-tagged so they don't run in CI by default
# (`bazel test //compiler_v2/...` skips them).  Run explicitly when
# you want numbers:
#
#   bazel run -c opt //compiler_v2/bench:kernel_bench
#   bazel run -c opt //compiler_v2/bench:pipeline_bench
#
# Always pass `-c opt`; debug builds with sanitizers blow the timing
# numbers up by ~10x and are useless as a baseline.

# Deliverable A — runtime kernel microbenches.  Each BM_* function
# stages operands once outside the loop and times one tight call to a
# single cel_runtime.c helper.  Covers arithmetic, comparison,
# aggregate, 3VL, conversion, and string-op kernels.
cc_binary(
    name = "kernel_bench",
    srcs = ["kernel_bench.cc"],
    copts = ["-std=c++17"],
    tags = ["manual"],
    deps = [
        "//compiler_v2/runtime:cel_runtime",
        "@com_google_absl//absl/strings",
        "@com_google_benchmark//:benchmark_main",
    ],
)

# Deliverable B — end-to-end pipeline wall-clock benches.  Measures
# the public Compiler::Compile + Engine::Plan + Instance::Eval surface
# with proper caching boundaries (Compiler shared across iterations of
# a Compile bench; Compile+Plan pre-staged for an Eval-only steady
# state bench).  One representative expression per AST kind.
cc_binary(
    name = "pipeline_bench",
    srcs = ["pipeline_bench.cc"],
    copts = ["-std=c++17"],
    tags = ["manual"],
    deps = [
        "//compiler/testdata:e2e_fixture_cc_proto",
        "//compiler_v2/api:activation",
        "//compiler_v2/api:cel_host",  # for Value::Message(proto)
        "//compiler_v2/api:compiler",
        "//compiler_v2/api:engine",
        "//compiler_v2/api:instance",
        "//compiler_v2/api:program",
        "//compiler_v2/api:type",
        "//compiler_v2/api:value",
        "@com_google_absl//absl/log:absl_check",
        "@com_google_absl//absl/strings",
        "@com_google_benchmark//:benchmark_main",
    ],
)


# Throwaway baseline benchmark for M7B (Timestamp/Duration).  Times
# the cel-cpp interpreter on a curated cohort drawn from the
# conformance corpus; gives us a number to compete against when
# M7B's pure-wasm kernels + host trampolines land.  Delete when M7B
# ships a paired bench.
#
#   bazel run -c opt //compiler_v2/bench:cel_cpp_ts_dur_bench -- \
#       --benchmark_min_time=0.1s
cc_binary(
    name = "cel_cpp_ts_dur_bench",
    srcs = ["cel_cpp_ts_dur_bench.cc"],
    copts = ["-std=c++17"],
    tags = ["manual"],
    deps = [
        "@cel-cpp//checker:validation_result",
        "@cel-cpp//common:ast",
        "@cel-cpp//common:ast_proto",
        "@cel-cpp//common:value",
        "@cel-cpp//compiler",
        "@cel-cpp//compiler:compiler_factory",
        "@cel-cpp//compiler:standard_library",
        "@cel-cpp//runtime",
        "@cel-cpp//runtime:activation",
        "@cel-cpp//runtime:runtime_builder",
        "@cel-cpp//runtime:runtime_options",
        "@cel-cpp//runtime:standard_runtime_builder_factory",
        "@com_google_absl//absl/log:absl_check",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings:string_view",
        "@com_google_benchmark//:benchmark_main",
        "//proto/cel/expr:checked_cc_proto",
        "@com_google_protobuf//:protobuf",
    ],
)


# Reports the wasm byte size of representative compiled programs at
# optimize_level 0 vs 2.  Used to populate the "Program size" table
# in compiler_v2/README.md.  Not a benchmark (no timing); just a
# size reporter.  Run with:
#   bazel run -c opt //compiler_v2/bench:program_size_main
cc_binary(
    name = "program_size_main",
    srcs = ["program_size_main.cc"],
    copts = ["-std=c++17"],
    tags = ["manual"],
    deps = [
        "//compiler_v2/api:activation",
        "//compiler_v2/api:compiler",
        "//compiler_v2/api:program",
        "//compiler_v2/api:type",
        "//compiler_v2/api:value",
        "//compiler_v2/frontend:parse_and_check",
        "//compiler_v2/runtime:cel_runtime",
        "//proto/cel/expr:checked_cc_proto",
        "@cel-cpp//common:ast_proto",
        "@com_google_absl//absl/log:absl_check",
        "@com_google_absl//absl/strings",
    ],
)
