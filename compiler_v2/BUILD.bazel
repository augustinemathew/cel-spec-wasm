load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//compiler_v2:__subpackages__"])

# Top-level pipeline facade.  Stitches parse → check → resolve → layout →
# module-setup → lower so the CLI / host_loader / e2e tests don't each
# re-wire the passes.  Output is a `CompiledArtifact` bundling the typed
# AST, the static layout, the Binaryen module, the `$eval` handle, and
# (optionally) the serialised wasm bytes.
cc_library(
    name = "compile",
    srcs = ["compile.cc"],
    hdrs = ["compile.h"],
    deps = [
        "//compiler_v2/codegen:expr_lower",
        "//compiler_v2/codegen:layout_pass",
        "//compiler_v2/codegen:module",
        "//compiler_v2/codegen:resolve_pass",
        "//compiler_v2/frontend:parse_and_check",
        "//compiler_v2/ir:typed_ast",
        "@binaryen//:binaryen",
        "@com_google_absl//absl/base:core_headers",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/types:span",
    ],
)

cc_test(
    name = "compile_test",
    srcs = ["compile_test.cc"],
    deps = [
        ":compile",
        "@binaryen//:binaryen",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:status_matchers",
        "@com_google_googletest//:gtest_main",
    ],
)
