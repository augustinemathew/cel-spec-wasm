# M2 e2e test suite — the spec of "done" for idents / kSelect /
# has() / partial-eval.  Full-pipeline tests go through
# Compiler::Compile → Engine::Plan → Instance::Eval(activation) /
# Instance::PartialEval(activation, patterns).  Depends on the
# shared proto fixtures at //compiler/testdata.
cc_test(
    name = "m2_test",
    srcs = ["m2_test.cc"],
    deps = [
        "//compiler/testdata:e2e_fixture_cc_proto",
        "//compiler/testdata:host_fixture_proto3_cc_proto",
        "//compiler_v2/api:activation",
        "//compiler_v2/api:attribute",
        "//compiler_v2/api:cel_host",  # for Value::Message(proto)
        "//compiler_v2/api:compiler",
        "//compiler_v2/api:engine",
        "//compiler_v2/api:instance",
        "//compiler_v2/api:program",
        "//compiler_v2/api:type",
        "//compiler_v2/api:value",
        "@com_google_absl//absl/log:absl_check",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:status_matchers",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/types:span",
        "@com_google_googletest//:gtest_main",
    ],
)

