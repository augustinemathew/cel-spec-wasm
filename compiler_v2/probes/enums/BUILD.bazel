load("@rules_cc//cc:defs.bzl", "cc_test")

package(default_visibility = ["//compiler_v2:__subpackages__"])

# M20 enum probe.  Links cel-cpp's REAL compiler + runtime and runs the
# `strong_proto2` expressions from `tests/simple/testdata/enums.textproto`
# end-to-end, to demonstrate that cel-cpp itself decays enums to int and
# would FAIL those rows — the evidence behind M20 descoping strong enums
# (doc/implementation-plan/rewrite/m20-enum-field-range.md §6).  Disposable;
# delete at M20 closeout.
cc_test(
    name = "cel_cpp_strong_enum_probe_test",
    srcs = ["cel_cpp_strong_enum_probe_test.cc"],
    tags = ["manual"],
    deps = [
        "//proto/cel/expr:checked_cc_proto",
        "//proto/cel/expr/conformance/proto2:test_all_types_cc_proto",
        "@cel-cpp//common:ast_proto",
        "@cel-cpp//common:value",
        "@cel-cpp//compiler",
        "@cel-cpp//compiler:compiler_factory",
        "@cel-cpp//compiler:standard_library",
        "@cel-cpp//extensions/protobuf:enum_adapter",
        "@cel-cpp//extensions/protobuf:runtime_adapter",
        "@cel-cpp//runtime",
        "@cel-cpp//runtime:activation",
        "@cel-cpp//runtime:reference_resolver",
        "@cel-cpp//runtime:runtime_options",
        "@cel-cpp//runtime:standard_runtime_builder_factory",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_googletest//:gtest_main",
        "@com_google_protobuf//:protobuf",
    ],
)
