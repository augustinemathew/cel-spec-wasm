load("@rules_cc//cc:defs.bzl", "cc_test")

package(default_visibility = ["//compiler_v2:__subpackages__"])

# network_ext AST-shape probe.  cel-cpp ships NO network extension
# checker library, so this probe PROVES we can self-declare the two
# abstract types (`net.IP`, `net.CIDR`) and the ~16 functions directly
# on a TypeCheckerBuilder — the same MakeFunctionDecl / AddOverload /
# AddFunction / AddVariable pattern checker/optional.cc uses — then
# type-checks a representative battery from
# tests/simple/testdata/network_ext.textproto and dumps the resulting
# CheckedExpr + reference_map overload ids.  Answers, per shape:
#
#   - does it type-check against the self-declared decls?
#   - is `cidr(...).containsIP(...)` a receiver call (target set)?
#   - is `ip(...)` a global call?  what does `net.IP` reach as?
#   - what overload id(s) + result type does the checker assign?
#
# Tagged `manual` — run explicitly with --test_output=all to read the
# dumps; not part of the default `bazel test //compiler_v2/...`.
cc_test(
    name = "ast_shape_probe_test",
    srcs = ["ast_shape_probe_test.cc"],
    tags = ["manual"],
    deps = [
        "@cel-cpp//checker:standard_library",
        "@cel-cpp//checker:type_checker",
        "@cel-cpp//checker:type_checker_builder",
        "@cel-cpp//checker:type_checker_builder_factory",
        "@cel-cpp//checker:validation_result",
        "@cel-cpp//common:ast",
        "@cel-cpp//common:ast_proto",
        "@cel-cpp//common:decl",
        "@cel-cpp//common:source",
        "@cel-cpp//common:type",
        "@cel-spec//proto/cel/expr:checked_cc_proto",
        "@cel-spec//proto/cel/expr:syntax_cc_proto",
        "@cel-cpp//parser",
        "@cel-cpp//parser:macro_registry",
        "@cel-cpp//parser:options",
        "@cel-cpp//parser:standard_macros",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/types:span",
        "@com_google_googletest//:gtest_main",
        "@com_google_protobuf//:protobuf",
    ],
)
