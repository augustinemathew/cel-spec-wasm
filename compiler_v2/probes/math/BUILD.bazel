load("@rules_cc//cc:defs.bzl", "cc_test")

package(default_visibility = ["//compiler_v2:__subpackages__"])

# math-extension AST-shape probe.  Parses + type-checks representative
# `math.*` expressions against cel-cpp's standard macros + the math
# macros (math.greatest / math.least desugaring) and the standard
# checker library + MathCheckerLibrary(), then dumps the resulting
# CheckedExpr + reference_map overload ids.  Its purpose is to confirm
# the assumptions the M16 (math_ext) design rests on:
#
#   - Do math.greatest / math.least expand at parse time into calls of
#     the internal functions math.@max / math.@min, or survive as
#     receiver-style calls codegen would have to special-case?
#   - What's the post-macro arg shape (scalar stays scalar; 3+ args
#     collapse into a single list literal; an explicit list literal
#     stays a single list arg)?
#   - What resolved overload id does the checker assign each call?
#   - What result type does the checker assign?
#
# Tagged `manual` — run explicitly with --test_output=all to read the
# dumps; not part of the default `bazel test //compiler_v2/...`.
cc_test(
    name = "ast_shape_probe_test",
    srcs = ["ast_shape_probe_test.cc"],
    tags = ["manual"],
    deps = [
        "@cel-cpp//checker:standard_library",
        "@cel-cpp//checker:type_checker",
        "@cel-cpp//checker:type_checker_builder_factory",
        "@cel-cpp//checker:validation_result",
        "@cel-cpp//common:ast",
        "@cel-cpp//common:ast_proto",
        "@cel-cpp//common:source",
        "@cel-cpp//extensions:math_ext_decls",
        "@cel-cpp//extensions:math_ext_macros",
        "@cel-spec//proto/cel/expr:checked_cc_proto",
        "@cel-spec//proto/cel/expr:syntax_cc_proto",
        "@cel-cpp//parser",
        "@cel-cpp//parser:macro_registry",
        "@cel-cpp//parser:options",
        "@cel-cpp//parser:standard_macros",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_googletest//:gtest_main",
        "@com_google_protobuf//:protobuf",
    ],
)
