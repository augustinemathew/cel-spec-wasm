load("@rules_cc//cc:defs.bzl", "cc_test")

package(default_visibility = ["//compiler_v2:__subpackages__"])

# CEL-optionals probes.  These tests parse + type-check
# representative optional expressions against cel-cpp's
# `OptionalCompilerLibrary` (parser macros + checker decls) and
# inspect the resulting AST + type_map.  Their purpose is to
# disprove or confirm specific assumptions the optional design
# rests on:
#
#   - Does `.?field` reach the IR as a `Call` to `_?._`, or get
#     expanded to has/ternary?
#   - Does `[?key]` reach as `_[?_]`?
#   - Does `{?key: val}` carry an `optional_entry: true` flag, or
#     get desugared?
#   - Does `[?elem]` populate `CreateList.optional_indices`, or
#     get desugared?
#   - What's the post-macro shape of `optMap` / `optFlatMap`?
#   - What CelType does the checker assign to `optional<int>`?
#   - What overload IDs land in the reference_map for each
#     optional-related call?
#
# Tagged `manual` — run explicitly when iterating on the M13
# design; not part of the default `bazel test //compiler_v2/...`.
cc_test(
    name = "ast_shape_probe_test",
    srcs = ["ast_shape_probe_test.cc"],
    tags = ["manual"],
    deps = [
        "@cel-cpp//checker:optional",
        "@cel-cpp//checker:standard_library",
        "@cel-cpp//checker:type_check_issue",
        "@cel-cpp//checker:type_checker",
        "@cel-cpp//checker:type_checker_builder",
        "@cel-cpp//checker:type_checker_builder_factory",
        "@cel-cpp//checker:validation_result",
        "@cel-cpp//common:ast",
        "@cel-cpp//common:ast_proto",
        "@cel-cpp//common:expr",
        "@cel-cpp//common:source",
        "@cel-cpp//common/ast:expr_proto",
        "@cel-cpp//extensions:bindings_ext",
        "@cel-cpp//extensions:strings",
        "@cel-spec//proto/cel/expr:checked_cc_proto",
        "@cel-spec//proto/cel/expr:syntax_cc_proto",
        "@cel-cpp//parser",
        "@cel-cpp//parser:macro",
        "@cel-cpp//parser:macro_registry",
        "@cel-cpp//parser:options",
        "@cel-cpp//parser:standard_macros",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_googletest//:gtest_main",
        "@com_google_protobuf//:protobuf",
    ],
)
