load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//compiler_v2:__subpackages__"])

# Native-host build of the runtime.  Used by unit tests and by host-side
# code that needs the CelValue layout (codegen, cel_log, tests).
cc_library(
    name = "cel_runtime",
    srcs = [
        "cel_3vl.c",
        "cel_arena.c",
        "cel_arith.c",
        "cel_compare.c",
        "cel_convert.c",
        "cel_internal.h",
        "cel_log.c",
        "cel_make.c",
        "cel_memory.c",
        "cel_runtime.c",
        "cel_string_ops.c",
        "cel_time.c",
        "cel_type.c",
    ],
    hdrs = [
        "cel_3vl.h",
        "cel_arena.h",
        "cel_arith.h",
        "cel_compare.h",
        "cel_convert.h",
        "cel_data.h",
        "cel_layout.h",
        "cel_list.h",
        "cel_log.h",
        "cel_make.h",
        "cel_map.h",
        "cel_memory.h",
        "cel_runtime.h",
        "cel_string_ops.h",
        "cel_time.h",
        "cel_type.h",
    ],
    copts = [
        "-std=c11",
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
        # Speed knobs.  -O3 + -flto let the linker inline across the
        # per-topic .c files split out by `cel-runtime-c-split-plan.md`.
        # The static-inline helpers in cel_internal.h (`poison` /
        # `absorb_3vl_*` / `write_*` / `require_kinds`) already inline at
        # -O2; -O3 widens aggressiveness on vectorisable inner loops
        # (`utf8_valid`, `write_uint_decimal`, parse loops), and LTO
        # lets `cel_int_add_at_vv` inline its kind-check into call
        # sites in `cel_arith.c` callers across TU boundaries.
        "-O3",
        "-flto",
    ],
    linkopts = [
        "-flto",
    ],
)

