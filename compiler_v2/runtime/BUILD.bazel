load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//compiler_v2:__subpackages__"])

# Native-host build of the runtime.  Used by unit tests and by host-side
# code that needs the CelValue layout (codegen, cel_log, tests).
cc_library(
    name = "cel_runtime",
    srcs = ["cel_runtime.c"],
    hdrs = [
        "cel_3vl.h",
        "cel_arena.h",
        "cel_arith.h",
        "cel_compare.h",
        "cel_data.h",
        "cel_list.h",
        "cel_log.h",
        "cel_make.h",
        "cel_map.h",
        "cel_memory.h",
        "cel_runtime.h",
        "cel_string_ops.h",
        "cel_type.h",
    ],
    copts = [
        "-std=c11",
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
    ],
)

