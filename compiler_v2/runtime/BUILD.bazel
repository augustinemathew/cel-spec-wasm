load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//third_party/wasi_sdk:wasm_cc_binary.bzl", "wasm_cc_binary")

package(default_visibility = ["//compiler_v2:__subpackages__"])

# `wasm_exports.txt` is the canonical list of symbols
# `cel_runtime.wasm` exports.  Two consumers below:
#
#   1. `wasm_export_args` genrule — converts the text file to a
#      wasm-ld response file (one `--export=<name>` per line).
#      `cel_runtime_wasm.bin` picks it up via `-Wl,@<rsp>`.
#   2. `//compiler_v2/abi:runtime_catalogue_consistency_test` —
#      reads the text file at test time and asserts the
#      `[codegen-helpers]` section is identical to
#      `celwasm::abi::CelRuntimeHelpers()`.
#
# Exported as a plain file so the test (in `//compiler_v2/abi`)
# can `data = ["//compiler_v2/runtime:wasm_exports.txt"]` it.
exports_files(
    ["wasm_exports.txt"],
    visibility = ["//compiler_v2/abi:__subpackages__"],
)

# Convert `wasm_exports.txt` into a wasm-ld response file.  The
# response file is one arg per line: `--export=foo`.  Consumed by
# `cel_runtime_wasm.bin`'s linkopts via `-Wl,@$(location ...)`.
#
# We strip section headers (`[name]`), comments (`#...`), blanks,
# and keep only the first whitespace-separated token of each
# remaining line — that's the symbol name.  `awk` is on every
# bazel-supported host; no extra toolchain dep.
genrule(
    name = "wasm_export_args",
    srcs = ["wasm_exports.txt"],
    outs = ["wasm_export_args.rsp"],
    cmd = """
awk '
  /^[[:space:]]*#/    { next }
  /^[[:space:]]*$$/   { next }
  /^[[:space:]]*\\[/  { next }
  { print "--export=" $$1 }
' $< > $@
""",
)

# Gates the `-DCEL_LOG_DISABLED` define on -c opt builds.  Every public
# runtime helper does a `CEL_LOG("enter")` host trampoline that
# `fprintf`s to stderr.  Useful for the dead-code audit (see
# `cel_log.h`); fatal to per-Eval performance once kernels start
# stacking.  Keep CEL_LOG live for dbg/fastbuild; disable it for opt
# benches + opt-built deploys.  See bench/README.md baseline note.
config_setting(
    name = "opt_mode",
    values = {"compilation_mode": "opt"},
)

# Native-host build of the runtime.  Used by unit tests and by host-side
# code that needs the CelValue layout (codegen, cel_log, tests).
cc_library(
    name = "cel_runtime",
    srcs = [
        "cel_3vl.c",
        "cel_arena.c",
        "cel_arith.c",
        "cel_compare.c",
        "cel_convert.c",
        "cel_internal.h",
        "cel_log.c",
        "cel_make.c",
        "cel_math_ext.c",
        "cel_memory.c",
        "cel_runtime.c",
        "cel_string_ops.c",
        "cel_time.c",
        "cel_type.c",
    ],
    hdrs = [
        "cel_3vl.h",
        "cel_arena.h",
        "cel_arith.h",
        "cel_compare.h",
        "cel_convert.h",
        "cel_data.h",
        "cel_layout.h",
        "cel_list.h",
        "cel_log.h",
        "cel_make.h",
        "cel_map.h",
        "cel_math_ext.h",
        "cel_memory.h",
        "cel_runtime.h",
        "cel_string_ops.h",
        "cel_time.h",
        "cel_type.h",
    ],
    copts = [
        "-std=c11",
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
        # Speed knobs.  -O3 + -flto let the linker inline across the
        # per-topic .c files split out by `cel-runtime-c-split-plan.md`.
        # The static-inline helpers in cel_internal.h (`poison` /
        # `absorb_3vl_*` / `write_*` / `require_kinds`) already inline at
        # -O2; -O3 widens aggressiveness on vectorisable inner loops
        # (`utf8_valid`, `write_uint_decimal`, parse loops), and LTO
        # lets `cel_int_add_at_vv` inline its kind-check into call
        # sites in `cel_arith.c` callers across TU boundaries.
        "-O3",
        "-flto",
    ] + select({
        ":opt_mode": ["-DCEL_LOG_DISABLED"],
        "//conditions:default": [],
    }),
    linkopts = [
        "-flto",
    ],
)

