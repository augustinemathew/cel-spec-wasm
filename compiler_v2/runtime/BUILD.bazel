    ],
)

# Phase C — wasm32-wasi-threads cross-compile via the `//third_party/
# wasi_sdk:wasm32_wasi` cc_toolchain.  Replaces the legacy genrule
# (which invoked wasi-sdk clang directly).  Built under the wasm
# platform via `wasm_cc_binary`, which transitions the configuration
# at the edge so downstream native consumers (the bytes-embed genrule
# below) can depend on it without flipping `--platforms` themselves.
#
# Per `doc/implementation-plan/rewrite/wasi/DESIGN.md` §3 + the
# Phase C plan, the runtime OWNS its memory and exports it; the
# expr module imports `cel.memory` from the runtime instance at
# link time.  Bytes [0, 8192) are reserved via
# `-Wl,--global-base=8192` for the expr module's active data
# segments.
#
# The target uses `wasm32-wasi-threads` because the toolchain
# (which links absl + RE2 in Phase C) needs `<mutex>` for cctz.
# Pure-C kernels don't actually use threading primitives —
# `wasm-ld` dead-strips unused wasi imports — so this costs
# nothing here.  See `rewrite/phase-c-plan.md` §7.2.
cc_binary(
    name = "cel_runtime_wasm.bin",
    srcs = [
        "cel_3vl.c",
        "cel_3vl.h",
        "cel_arena.c",
        "cel_arena.h",
        "cel_arith.c",
        "cel_arith.h",
        "cel_compare.c",
        "cel_compare.h",
        "cel_convert.c",
        "cel_convert.h",
        "cel_data.h",
        "cel_internal.h",
        "cel_layout.h",
        "cel_list.h",
        "cel_log.c",
        "cel_log.h",
        "cel_make.c",
        "cel_make.h",
        "cel_map.h",
        "cel_memory.c",
        "cel_memory.h",
        "cel_runtime.c",
        "cel_runtime.h",
        "cel_string_ops.c",
        "cel_string_ops.h",
        "cel_time.c",
        "cel_time.h",
        "cel_type.c",
        "cel_type.h",
    ],
    additional_linker_inputs = [
        "wasm_imports.txt",
    ],
    copts = [
        # `__attribute__((musttail))` requires the wasm tail-call
        # feature to lower as `return_call`.  Without `-mtail-call`
        # clang errors out rather than silently downgrading — that's
        # the point.  wasmtime config also gets the matching flag in
        # api/engine.cc.
        "-mtail-call",
        # Per-target warnings beyond toolchain's `-Wall`.
        "-Wextra",
        "-Wno-unused-parameter",
    ] + select({
        ":opt_mode": ["-DCEL_LOG_DISABLED"],
        "//conditions:default": [],
    }),
    linkopts = [
        # No standard startup files; runtime is library code, no main.
        "-nostartfiles",
        "-Wl,--no-entry",
        # Reserve [0, 8192) for the expr module's active data segments.
        # Per DESIGN.md §3 / experiments/exp_a_rodata.c.
        "-Wl,--global-base=8192",
        # Tight import allowlist.  The toolchain's default link flags
        # include the broader `-Wl,--allow-undefined`; this file-based
        # form is documented for the day the toolchain feature is
        # split out so per-target strict mode is opt-in.
        "-Wl,--allow-undefined-file=$(location wasm_imports.txt)",
        # Runtime owns and exports its memory.  By default
        # wasi-sdk's wasm-ld exports the module-defined memory as
        # `memory`; the host pulls it off `runtime_instance` after
        # instantiation, then binds it on the linker as `cel.memory`
        # so the expr module (which still imports `cel.memory`)
        # resolves to the same backing store.
        # Surface malloc + free for host reentry (activation marshalling)
        # and for the arena to allocate its backing buffer.
        "-Wl,--export=malloc",
        "-Wl,--export=free",
        # __heap_base is exposed so the host can verify it sits
        # above the reserved [0, 8192) region.
        "-Wl,--export=__heap_base",
        # The arena API: host reentry uses arena_init + arena_alloc;
        # codegen prologue emits (call $arena_reset).
        "-Wl,--export=arena_init",
        "-Wl,--export=arena_alloc",
        "-Wl,--export=arena_reset",
        "-Wl,--export=arena_cursor",
        "-Wl,--export=arena_capacity",
        "-Wl,--export=cel_map_create",
        "-Wl,--export=cel_map_insert",
        "-Wl,--export=cel_map_insert_at",
        "-Wl,--export=cel_map_insert_at_if_bool",
        "-Wl,--export=cel_map_lookup",
        "-Wl,--export=cel_map_lookup_arena",
        "-Wl,--export=cel_list_create",
        "-Wl,--export=cel_list_append_at",
        "-Wl,--export=cel_list_append_at_if_bool",
        "-Wl,--export=cel_list_at",
        "-Wl,--export=cel_list_at_arena",
        # Arithmetic helpers (int / uint / double × add/sub/mul/div/mod/neg).
        "-Wl,--export=cel_int_add_at_vv",
        "-Wl,--export=cel_int_sub_at_vv",
        "-Wl,--export=cel_int_mul_at_vv",
        "-Wl,--export=cel_int_div_at_vv",
        "-Wl,--export=cel_int_mod_at_vv",
        "-Wl,--export=cel_int_neg_at_v",
        "-Wl,--export=cel_uint_add_at_vv",
        "-Wl,--export=cel_uint_sub_at_vv",
        "-Wl,--export=cel_uint_mul_at_vv",
        "-Wl,--export=cel_uint_div_at_vv",
        "-Wl,--export=cel_uint_mod_at_vv",
        "-Wl,--export=cel_double_add_at_vv",
        "-Wl,--export=cel_double_sub_at_vv",
        "-Wl,--export=cel_double_mul_at_vv",
        "-Wl,--export=cel_double_div_at_vv",
        "-Wl,--export=cel_double_neg_at_v",
        # Comparison helpers (per-kind eq/ne/lt/le/gt/ge + bool/null).
        "-Wl,--export=cel_int_eq_at_vv",
        "-Wl,--export=cel_int_ne_at_vv",
        "-Wl,--export=cel_int_lt_at_vv",
        "-Wl,--export=cel_int_le_at_vv",
        "-Wl,--export=cel_int_gt_at_vv",
        "-Wl,--export=cel_int_ge_at_vv",
        "-Wl,--export=cel_uint_eq_at_vv",
        "-Wl,--export=cel_uint_ne_at_vv",
        "-Wl,--export=cel_uint_lt_at_vv",
        "-Wl,--export=cel_uint_le_at_vv",
        "-Wl,--export=cel_uint_gt_at_vv",
        "-Wl,--export=cel_uint_ge_at_vv",
        "-Wl,--export=cel_double_eq_at_vv",
        "-Wl,--export=cel_double_ne_at_vv",
        "-Wl,--export=cel_double_lt_at_vv",
        "-Wl,--export=cel_double_le_at_vv",
        "-Wl,--export=cel_double_gt_at_vv",
        "-Wl,--export=cel_double_ge_at_vv",
        "-Wl,--export=cel_bool_eq_at_vv",
        "-Wl,--export=cel_bool_ne_at_vv",
        "-Wl,--export=cel_bool_lt_at_vv",
        "-Wl,--export=cel_bool_le_at_vv",
        "-Wl,--export=cel_bool_gt_at_vv",
        "-Wl,--export=cel_bool_ge_at_vv",
        "-Wl,--export=cel_null_eq_at_vv",
        # Cross-type numeric ladder (eq/ne/lt/le/gt/ge).
        "-Wl,--export=cel_numeric_eq_at_vv",
        "-Wl,--export=cel_numeric_ne_at_vv",
        "-Wl,--export=cel_numeric_lt_at_vv",
        "-Wl,--export=cel_numeric_le_at_vv",
        "-Wl,--export=cel_numeric_gt_at_vv",
        "-Wl,--export=cel_numeric_ge_at_vv",
        # String + bytes ops (concat allocates; rest read-only).
        "-Wl,--export=cel_string_concat_at_vv",
        "-Wl,--export=cel_string_size_at_v",
        "-Wl,--export=cel_string_eq_at_vv",
        "-Wl,--export=cel_string_lt_at_vv",
        "-Wl,--export=cel_string_le_at_vv",
        "-Wl,--export=cel_string_gt_at_vv",
        "-Wl,--export=cel_string_ge_at_vv",
        "-Wl,--export=cel_string_contains_at_vv",
        "-Wl,--export=cel_string_starts_with_at_vv",
        "-Wl,--export=cel_string_ends_with_at_vv",
        "-Wl,--export=cel_bytes_concat_at_vv",
        "-Wl,--export=cel_bytes_size_at_v",
        "-Wl,--export=cel_bytes_eq_at_vv",
        "-Wl,--export=cel_bytes_lt_at_vv",
        "-Wl,--export=cel_bytes_le_at_vv",
        "-Wl,--export=cel_bytes_gt_at_vv",
        "-Wl,--export=cel_bytes_ge_at_vv",
        # Aggregate arena fast paths.
        "-Wl,--export=cel_list_size_arena",
        "-Wl,--export=cel_list_in_arena",
        "-Wl,--export=cel_list_eq_arena",
        "-Wl,--export=cel_list_concat_arena",
        "-Wl,--export=cel_map_size_arena",
        "-Wl,--export=cel_map_in_arena",
        "-Wl,--export=cel_map_eq_arena",
        # Aggregate kDynamic dispatchers.  Each tail-calls into the
        # corresponding _arena fast path or the cel_host.* import.
        "-Wl,--export=cel_list_size",
        "-Wl,--export=cel_list_in",
        "-Wl,--export=cel_list_eq",
        "-Wl,--export=cel_list_concat",
        "-Wl,--export=cel_map_size",
        "-Wl,--export=cel_map_in",
        "-Wl,--export=cel_map_eq",
        # Map-key iteration helpers used by comprehensions over a
        # `map(K, V)` source.
        "-Wl,--export=cel_map_iter_init",
        "-Wl,--export=cel_map_iter_next",
        "-Wl,--export=cel_map_iter_key_at",
        "-Wl,--export=cel_map_iter_value_at",
        # Polymorphic equality.
        "-Wl,--export=cel_equals_at_vv",
        "-Wl,--export=cel_not_equals_at_vv",
        # 3VL / control-flow helpers.
        "-Wl,--export=cel_and",
        "-Wl,--export=cel_or",
        "-Wl,--export=cel_not",
        "-Wl,--export=cel_unknown_merge",
        "-Wl,--export=cel_copy_slot",
        # type-of helper (see `rewrite/m9-type-subsystem.md`).
        "-Wl,--export=cel_type_of_at_v",
        # Numeric inter-conversion helpers (see `rewrite/m10-conversions.md`).
        "-Wl,--export=cel_uint_to_int_at_v",
        "-Wl,--export=cel_double_to_int_at_v",
        "-Wl,--export=cel_int_to_uint_at_v",
        "-Wl,--export=cel_double_to_uint_at_v",
        "-Wl,--export=cel_int_to_double_at_v",
        "-Wl,--export=cel_uint_to_double_at_v",
        # String-parse helpers.
        "-Wl,--export=cel_string_to_int_at_v",
        "-Wl,--export=cel_string_to_uint_at_v",
        "-Wl,--export=cel_string_to_double_at_v",
        "-Wl,--export=cel_string_to_bool_at_v",
        # Number/bool-to-string formatters.
        "-Wl,--export=cel_int_to_string_at_v",
        "-Wl,--export=cel_uint_to_string_at_v",
        "-Wl,--export=cel_bool_to_string_at_v",
        "-Wl,--export=cel_double_to_string_at_v",
        # Bytes <-> string with UTF-8 validation.
        "-Wl,--export=cel_string_to_bytes_at_v",
        "-Wl,--export=cel_bytes_to_string_at_v",
        # Timestamp / duration arithmetic + ordering.
        "-Wl,--export=cel_dur_add_at_vv",
