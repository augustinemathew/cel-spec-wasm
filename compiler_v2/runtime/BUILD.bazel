        "-Wl,--export=cel_and",
        "-Wl,--export=cel_or",
        "-Wl,--export=cel_not",
        "-Wl,--export=cel_unknown_merge",
        "-Wl,--export=cel_copy_slot",
        # M9.B: type-of helper.
        "-Wl,--export=cel_type_of_at_v",
        # M10.B: numeric inter-conversion helpers.
        "-Wl,--export=cel_uint_to_int_at_v",
