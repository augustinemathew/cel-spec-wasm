# Locks the runtime null-pointer-elision bug closed and the
# post-WASI arena ABI (`arena_init` / `arena_alloc` / `arena_reset`
# / `arena_cursor` / `arena_capacity`).  Loads the cross-compiled
# cel_runtime.wasm under wasmtime and exercises the arena via the
# real exports.  Pulls `cel_runtime_wasm_bytes` (manual) as a dep;
# bazel still builds manual deps when explicitly required by a
# non-manual target, so this test runs as part of
# `bazel test //compiler_v2/...`.
cc_test(
    name = "cel_runtime_wasm_test",
    srcs = ["cel_runtime_wasm_test.cc"],
    deps = [
        ":cel_runtime_wasm_bytes",
        "@com_google_absl//absl/log:absl_check",
        "@com_google_googletest//:gtest_main",
        "@wasmtime_darwin_arm64//:wasmtime",
    ],
)

# Phase C — C++ kernels linked into cel_runtime.wasm.  Each TU
# exposes a fixed set of `extern "C"` `cel_*_at_v` symbols matching
# the `(out_slot, in_slot)` ABI of every other runtime helper.  Lives
# in its own cc_library so the wasm32-wasi-threads toolchain applies
# cleanly and the runtime cc_binary just adds it to deps.
#
# `cel_time_parse`: timestamp / duration parse + format kernels via
# `absl::ParseTime` / `absl::ParseDuration` / `absl::FormatTime`.
# Replaces the four `cel_host.*` parse/format trampolines (Phase C
# slice C1/C2 per `phase-c-design.md`).
cc_test(
    name = "cel_time_parse_test",
    srcs = ["cel_time_parse_test.cc"],
    deps = [
        ":cel_runtime",
        ":cel_time_parse",
        "@com_google_googletest//:gtest_main",
    ],
)

cc_library(
    name = "cel_time_parse",
    srcs = ["cel_time_parse.cc"],
    hdrs = ["cel_time_parse.h"],
    copts = [
        "-Wno-unused-parameter",
    ],
    deps = [
        ":cel_runtime",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/time",
    ],
)

# `cel_matches`: regex PartialMatch kernel backed by RE2.  Per-Instance
# single-slot most-recent-pattern cache so a repeated `s.matches(p)`
# over the same pattern doesn't recompile each Eval.  Replaces the
# would-be `cel_host.cel_matches` trampoline by self-hosting RE2
# inside cel_runtime.wasm.  See `rewrite/phase-c-plan.md` §4.5.
cc_library(
    name = "cel_matches",
    srcs = ["cel_matches.cc"],
    hdrs = ["cel_matches.h"],
    deps = [
        ":cel_runtime",
        "@com_google_absl//absl/strings",
        "@re2",
    ],
)

cc_test(
    name = "cel_matches_test",
    srcs = ["cel_matches_test.cc"],
    deps = [
        ":cel_matches",
        ":cel_runtime",
        "@com_google_googletest//:gtest_main",
    ],
)

# M12 Slice A — `string_ext` extension kernels (cel-cpp's
# `extensions/strings.cc`), self-hosted inside cel_runtime.wasm.
# Slice A lands the UTF-8 helpers + 5 simplest functions: charAt,
# lowerAscii, upperAscii, trim, reverse.  Slices B-E layer
# search/extract, list-bridging (split/join), quote, and the
# format directive parser + renderer on top.  See
# `rewrite/m12-string-ext.md` for the slice plan.
cc_library(
    name = "cel_string_ext",
    srcs = ["cel_string_ext.cc"],
    hdrs = ["cel_string_ext.h"],
    deps = [
        ":cel_runtime",
        "@com_google_absl//absl/strings",
    ],
)

cc_test(
    name = "cel_string_ext_test",
    srcs = ["cel_string_ext_test.cc"],
    deps = [
        ":cel_runtime",
        ":cel_string_ext",
