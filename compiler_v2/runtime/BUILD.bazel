load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//compiler_v2:__subpackages__"])

# Native-host build of the runtime.  Used by unit tests and by host-side
# code that needs the CelValue layout (codegen, cel_log, tests).
cc_library(
    name = "cel_runtime",
    srcs = ["cel_runtime.c"],
    hdrs = [
        "cel_arena.h",
        "cel_data.h",
        "cel_list.h",
        "cel_log.h",
        "cel_make.h",
        "cel_map.h",
        "cel_memory.h",
        "cel_runtime.h",
    ],
    copts = [
        "-std=c11",
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
    ],
)

# Each test includes only the narrow header under test — this verifies
# the tiny headers are self-sufficient and don't secretly depend on the
# umbrella re-exporting something they forgot to include.
cc_test(
    name = "cel_arena_test",
    srcs = ["cel_arena_test.cc"],
    deps = [
        ":cel_runtime",
        "@com_google_googletest//:gtest_main",
    ],
)

cc_test(
    name = "cel_make_test",
    srcs = ["cel_make_test.cc"],
    deps = [
        ":cel_runtime",
        "@com_google_googletest//:gtest_main",
    ],
)

cc_test(
    name = "cel_memory_test",
    srcs = ["cel_memory_test.cc"],
    deps = [
        ":cel_runtime",
        "@com_google_googletest//:gtest_main",
    ],
)

cc_test(
    name = "cel_data_test",
    srcs = ["cel_data_test.cc"],
    deps = [
        ":cel_runtime",
        "@com_google_googletest//:gtest_main",
    ],
)

cc_test(
    name = "cel_map_test",
    srcs = ["cel_map_test.cc"],
    deps = [
        ":cel_runtime",
        "@com_google_googletest//:gtest_main",
    ],
)

cc_test(
    name = "cel_list_test",
    srcs = ["cel_list_test.cc"],
    deps = [
        ":cel_runtime",
        "@com_google_googletest//:gtest_main",
    ],
)

# Locks the runtime null-pointer-elision bug closed.  Loads the
# cross-compiled cel_runtime.wasm under wasmtime and asserts
# cel_reset / cel_alloc actually mutate memory bytes 8 / 12 (they
# don't, without the asm opacity barrier in cel_memory_base_).
# Tagged manual because the cel_runtime_wasm_bytes target is
# (genrule-via-brew-llvm, darwin-arm64 only).
cc_test(
    name = "cel_runtime_wasm_test",
    srcs = ["cel_runtime_wasm_test.cc"],
    tags = ["manual"],
    deps = [
        ":cel_runtime_wasm_bytes",
        "@com_google_absl//absl/log:absl_check",
        "@com_google_googletest//:gtest_main",
        "@wasmtime_darwin_arm64//:wasmtime",
    ],
)

# wasm32 cross-compile.  Per rewrite plan §8.1: the runtime no longer
# owns memory — the expr module does — so we pass `--import-memory=cel,memory`.
# Explicit `--export=` per symbol (no `--export-all`).  darwin-arm64 only
# due to brew-llvm absolute path.
genrule(
    name = "cel_runtime_wasm_file",
    srcs = [
        "cel_arena.h",
        "cel_data.h",
        "cel_list.h",
        "cel_log.h",
        "cel_make.h",
        "cel_map.h",
        "cel_memory.h",
        "cel_runtime.c",
        "cel_runtime.h",
        "wasm_imports.txt",
    ],
    outs = ["cel_runtime.wasm"],
    cmd = " ".join([
        "/opt/homebrew/opt/llvm/bin/clang",
        "--target=wasm32",
        "-ffreestanding",
        "-nostdlib",
        "-O2",
        # M3.C: `__attribute__((musttail))` requires the wasm tail-call
        # feature to lower as `return_call`.  Without `-mtail-call`
        # clang errors out rather than silently downgrading — that's
        # the point.  wasmtime config also gets the matching flag in
        # api/engine.cc.
        "-mtail-call",
        "-Wl,--no-entry",
        # `-Wl,` splits on commas, which would corrupt the two-arg
        # `--import-memory=<module>,<name>` form.  Use `-Xlinker` so
        # the argument reaches wasm-ld intact.
        "-Xlinker --import-memory=cel,memory",
        "-Wl,--export=cel_alloc",
        "-Wl,--export=cel_reset",
        "-Wl,--export=cel_map_create",
        "-Wl,--export=cel_map_insert",
        "-Wl,--export=cel_map_lookup",
        "-Wl,--export=cel_map_lookup_arena",
        "-Wl,--export=cel_list_create",
        "-Wl,--export=cel_list_set",
        "-Wl,--export=cel_list_at",
        "-Wl,--export=cel_list_at_arena",
        "-Wl,--allow-undefined-file=$(location :wasm_imports.txt)",
        "-I.",
        "-o $@",
        "$(location :cel_runtime.c)",
    ]),
    tags = [
        "manual",
        "no-sandbox",
    ],
)

genrule(
    name = "cel_runtime_wasm_bytes_cc",
    srcs = [":cel_runtime_wasm_file"],
    outs = ["cel_runtime_wasm_bytes.cc"],
    cmd = """
set -e
src=$(location :cel_runtime_wasm_file)
{
  echo '// Auto-generated by //compiler_v2/runtime:cel_runtime_wasm_bytes_cc.'
  echo '// Do not edit by hand; re-run the genrule to refresh.'
  echo '#include "compiler_v2/runtime/cel_runtime_wasm_bytes.h"'
  echo
  echo 'namespace celwasm {'
  echo
  echo 'const unsigned char kCelRuntimeWasmBytes[] = {'
  od -An -tu1 -v "$$src" | awk '{ for (i=1;i<=NF;i++) printf "0x%02x,", $$i; print "" }'
  echo '};'
  echo 'const unsigned int kCelRuntimeWasmBytesSize = sizeof(kCelRuntimeWasmBytes);'
  echo
  echo '}  // namespace celwasm'
} > $@
""",
    tags = ["manual"],
)

cc_library(
    name = "cel_runtime_wasm_bytes",
    srcs = [":cel_runtime_wasm_bytes_cc"],
    hdrs = ["cel_runtime_wasm_bytes.h"],
    tags = ["manual"],
)
