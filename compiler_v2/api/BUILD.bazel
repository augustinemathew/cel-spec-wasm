# ─── Plan §5.2 (revised) — runtime-isolation execution ────────────────
#
# Three classes:
#   - cel::Compiler  (compiler.{h,cc}) — pure compile-time front
#                    end.  Compile(source) → Program.  No wasmtime.
#   - cel::Program   (program.h)       — bytes + (future) ABI.
#                    Pure data type; serializable.  No wasmtime.
#   - cel::Engine    (engine.{h,cc})   — runtime side.  Owns the
#                    wasm_engine_t + parsed cel_runtime.wasm.
#                    Plan(program, bindings) → Instance lands in
#                    a follow-up commit.
#
# Compiler depends on the existing celwasm::Compile pipeline; no
# wasmtime dep on the public surface.  Engine pulls in wasmtime
# (darwin-arm64-only via brew llvm) so its targets are tagged
# manual.

# Internal — owns the wasmtime state held by cel::Engine.  In
# `celwasm::` per cel-host-surface.md §1 (public is `cel::`,
# internal is `celwasm::`).
cc_library(
    name = "wasmtime_engine_state",
    srcs = ["internal/wasmtime_engine_state.cc"],
    hdrs = ["internal/wasmtime_engine_state.h"],
    tags = ["manual"],
    deps = [
        "@wasmtime_darwin_arm64//:wasmtime",
    ],
)

# cel::Program — the compiled artifact.  Pure data: bytes +
# (future) ABI.  No wasmtime dep; can be serialized + shipped.
cc_library(
    name = "program",
    hdrs = ["program.h"],
    deps = [
        "@com_google_absl//absl/types:span",
    ],
)

cc_test(
    name = "program_test",
    srcs = ["program_test.cc"],
    deps = [
        ":program",
        "@com_google_googletest//:gtest_main",
    ],
)

# cel::Compiler — pure compile-time front end.  Wraps the
# existing celwasm::Compile pipeline; produces cel::Program.  No
# wasmtime dep.
cc_library(
    name = "compiler",
    srcs = ["compiler.cc"],
    hdrs = ["compiler.h"],
    deps = [
        ":program",
        ":type",
        "//compiler_v2:compile",
        "@com_google_absl//absl/base:core_headers",
        "@com_google_absl//absl/base:nullability",
        "@com_google_absl//absl/container:flat_hash_set",
        "@com_google_absl//absl/log:absl_check",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/types:span",
        "@com_google_protobuf//:protobuf",
    ],
)

cc_test(
    name = "compiler_test",
    srcs = ["compiler_test.cc"],
    deps = [
        ":compiler",
        ":program",
        ":type",
        "//compiler/testdata:e2e_fixture_cc_proto",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:status_matchers",
        "@com_google_googletest//:gtest_main",
    ],
)

# Internal — pImpl payload for cel::Instance.  Owned via
# unique_ptr from the public Instance.  Tagged manual; wasmtime dep.
cc_library(
    name = "instance_impl",
    srcs = ["internal/instance_impl.cc"],
    hdrs = ["internal/instance_impl.h"],
    tags = ["manual"],
    deps = [
        "@wasmtime_darwin_arm64//:wasmtime",
    ],
)

# cel::Instance — the live evaluator.  Constructed by Engine::Plan.
# Eval() decodes the wasm-side CelValue at the offset $eval returns
# into a public cel::Value.
cc_library(
    name = "instance",
    srcs = ["instance.cc"],
    hdrs = ["instance.h"],
    tags = ["manual"],
    deps = [
        ":instance_impl",
        ":value",
        ":wasmtime_engine_state",
        "//compiler_v2/runtime:cel_runtime",
        "@com_google_absl//absl/base:core_headers",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@wasmtime_darwin_arm64//:wasmtime",
    ],
)

cc_test(
    name = "instance_test",
    srcs = ["instance_test.cc"],
    tags = ["manual"],
    deps = [
        ":compiler",
        ":engine",
        ":instance",
        ":program",
        ":value",
        "@com_google_absl//absl/log:absl_check",
        "@com_google_absl//absl/status",
        "@com_google_googletest//:gtest_main",
    ],
)

# Per-stage cost across the user-facing pipeline (Compiler / Engine
# / Compile / Plan / Eval) plus four composite end-to-end shapes
# (Cold / WarmEngine / WarmProgram / HotEval) × 5 scalar-literal
# inputs.  See file header for what each bench measures and the
# architectural invariants the numbers should confirm.  Run with:
#   bazel run -c opt //compiler_v2/api:cel_pipeline_bench -- \
#       --benchmark_min_time=1s
cc_binary(
    name = "cel_pipeline_bench",
    srcs = ["cel_pipeline_bench.cc"],
    tags = ["manual"],
    deps = [
        ":compiler",
        ":engine",
        ":instance",
        ":program",
        "@com_google_absl//absl/log:absl_check",
        "@com_google_absl//absl/strings",
        "@com_google_benchmark//:benchmark_main",
    ],
)

# cel::Engine — runtime side.  Owns wasm_engine_t + parsed
# cel_runtime.wasm.  Plan(program) → Instance.
cc_library(
    name = "engine",
    srcs = ["engine.cc"],
    hdrs = ["engine.h"],
    tags = ["manual"],
    deps = [
        ":instance",
        ":instance_impl",
        ":program",
        ":wasmtime_engine_state",
        "//compiler_v2/host:cel_log",
        "//compiler_v2/runtime:cel_runtime_wasm_bytes",
        "@com_google_absl//absl/base:core_headers",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/types:span",
        "@wasmtime_darwin_arm64//:wasmtime",
    ],
)

cc_test(
    name = "engine_test",
    srcs = ["engine_test.cc"],
    tags = ["manual"],
    deps = [
        ":compiler",
        ":engine",
        ":instance",
        ":program",
        ":value",
        "@com_google_absl//absl/log:absl_check",
