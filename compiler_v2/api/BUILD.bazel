package(default_visibility = ["//compiler_v2:__subpackages__"])

# CelType — user-facing static type for declarations.  Leaf header; no
# compiler dependency.  See doc/implementation-plan/rewrite/
# cel-host-surface.md §2.
cc_library(
    name = "type",
    srcs = ["type.cc"],
    hdrs = ["type.h"],
    deps = [
        "@com_google_absl//absl/log:absl_check",
        "@com_google_absl//absl/strings",
    ],
)

cc_test(
    name = "type_test",
    srcs = ["type_test.cc"],
    deps = [
        ":type",
        "@com_google_googletest//:gtest_main",
    ],
)

