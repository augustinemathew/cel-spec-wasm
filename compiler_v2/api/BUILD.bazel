# ─── Plan §5.2 (revised) — runtime-isolation execution ────────────────
#
# Three classes:
#   - cel::Compiler  (compiler.{h,cc}) — pure compile-time front
#                    end.  Compile(source) → Program.  No wasmtime.
#   - cel::Program   (program.h)       — bytes + (future) ABI.
#                    Pure data type; serializable.  No wasmtime.
#   - cel::Engine    (engine.{h,cc})   — runtime side.  Owns the
#                    wasm_engine_t + parsed cel_runtime.wasm.
#                    Plan(program, bindings) → Instance lands in
#                    a follow-up commit.
#
# Compiler depends on the existing celwasm::Compile pipeline; no
# wasmtime dep on the public surface.  Engine pulls in wasmtime
# (darwin-arm64-only via brew llvm) so its targets are tagged
# manual.

# Internal — decode the `cel.abi` custom section from raw wasm
# bytes.  Consumed by Engine::Plan at load time (M2.B.2).
# Parses the wasm byte stream directly (no Binaryen dep) since
# the custom-section framing is simple and keeping the decoder
# self-contained limits blast radius on binaryen API changes.
cc_library(
    name = "abi_decode",
    srcs = ["internal/abi_decode.cc"],
    hdrs = ["internal/abi_decode.h"],
    deps = [
        "//compiler_v2/abi:cel_abi_cc_proto",
        "//compiler_v2/ir:annotations",
        "@com_google_absl//absl/base:core_headers",
        "@com_google_absl//absl/container:flat_hash_map",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/types:span",
    ],
)

cc_test(
    name = "abi_decode_test",
    srcs = ["internal/abi_decode_test.cc"],
    deps = [
        ":abi_decode",
        "//compiler/testdata:e2e_fixture_cc_proto",
        "//compiler_v2:compile",
        "//compiler_v2/abi:cel_abi_cc_proto",
        "//compiler_v2/ir:annotations",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:status_matchers",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/types:span",
        "@com_google_googletest//:gtest_main",
    ],
)

# Internal — Layer 1 of the cel_host stack
# (m2-ident-select-unknowns.md §2.4).  Pure CEL semantics:
# HostMessageBacking interface + ProtoBacking built-in.  Layer 2
# (MemoryView / ExternrefTable / ArenaAllocator + trampoline
# semantics) + Layer 3 (wasmtime glue) land in follow-up slices.
#
# Also defines `cel::Value::Message(const Message&)` so value.cc
# doesn't need to know about ProtoBacking — the library dep runs
# cel_host -> value (never the reverse) and the Value stores a
# forward-declared `HostMessageBacking` in its payload variant.
cc_library(
    name = "cel_host",
    srcs = ["internal/cel_host.cc"],
    hdrs = ["internal/cel_host.h"],
    deps = [
        ":attribute",
        ":error",
        ":type",
        ":value",
        "//compiler_v2/runtime:cel_runtime",
        "@com_google_absl//absl/base:core_headers",
        "@com_google_absl//absl/base:nullability",
        "@com_google_absl//absl/functional:function_ref",
        "@com_google_absl//absl/log:absl_check",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/types:span",
        "@com_google_protobuf//:protobuf",
    ],
)

# Header-only test fakes shared by every Layer-2 unit test that
