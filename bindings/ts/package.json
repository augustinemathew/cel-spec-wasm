{
  "name": "@celwasm/ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript CEL eval host (ts/eval) + cross-host conformance runner (ts/conformance). Mirrors compiler_v2/.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check --no-error-on-unmatched-pattern \"eval/**/*.ts\" \"conformance/**/*.ts\"",
    "format:fix": "prettier --write --no-error-on-unmatched-pattern \"eval/**/*.ts\" \"conformance/**/*.ts\"",
    "proto:gen": "protoc --plugin=protoc-gen-es=./node_modules/.bin/protoc-gen-es --es_out=eval/src/gen --es_opt=target=ts -I ../../abi cel_abi.proto",
    "proto:check": "node scripts/check-proto-gen.mjs",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:conformance": "vitest run --config vitest.conformance.config.ts",
    "coverage": "vitest run --coverage",
    "check": "npm run proto:check && npm run typecheck && npm run lint && npm run format && npm run coverage"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.12.0",
    "@eslint/js": "^9",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9",
    "eslint-config-prettier": "^9",
    "prettier": "^3",
    "typescript": "^5.6",
    "typescript-eslint": "^8",
    "vitest": "^2"
  }
}
