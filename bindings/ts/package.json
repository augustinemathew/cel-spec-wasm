{
  "name": "@cel-wasm/root",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript bindings for the cel-wasm AOT compiler and evaluator.",
  "type": "module",
  "workspaces": [
    "compiler",
    "eval",
    "conformance",
    "web"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "build:wasm": "bash scripts/build-wasm-assets.sh",
    "build": "tsc --build",
    "typecheck": "tsc --noEmit -p eval/tsconfig.json && tsc --noEmit -p compiler/tsconfig.json && tsc --noEmit -p conformance/tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.10.7",
    "@typescript-eslint/eslint-plugin": "8.21.0",
    "@typescript-eslint/parser": "8.21.0",
    "@vitest/coverage-v8": "3.2.6",
    "eslint": "9.39.4",
    "eslint-import-resolver-typescript": "3.7.0",
    "eslint-plugin-import": "2.31.0",
    "prettier": "3.4.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.21.0",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  }
}
