{
  "name": "@cel-wasm/web",
  "version": "0.1.0",
  "private": true,
  "description": "Browser demo: compile a CEL expression, download the .wasm, run it in-tab.",
  "type": "module",
  "scripts": {
    "build": "tsc --build tsconfig.build.json && vite build",
    "typecheck": "tsc --build tsconfig.build.json && tsc --noEmit -p tsconfig.json",
    "predev": "bash ../scripts/build-wasm-assets.sh",
    "dev": "vite",
    "prebuild": "bash ../scripts/build-wasm-assets.sh",
    "preview": "vite preview"
  },
  "dependencies": {
    "@cel-wasm/compiler": "0.1.0",
    "@cel-wasm/eval": "0.1.0",
    "monaco-editor": "0.52.2"
  },
  "devDependencies": {
    "jsdom": "25.0.1",
    "vite": "6.4.3"
  }
}
