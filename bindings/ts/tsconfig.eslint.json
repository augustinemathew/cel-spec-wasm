{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "allowJs": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": [
    "*.config.ts",
    "*.config.mjs",
    "eslint.config.mjs",
    "vitest.config.ts",
    "*/src/**/*.ts"
  ]
}
