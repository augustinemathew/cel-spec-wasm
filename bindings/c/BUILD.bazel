load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//third_party/wasi_sdk:wasm_cc_binary.bzl", "wasm_cpp_cc_binary")

# The C ABI seam over the C++ `celwasm::Compiler`.  An `extern "C"`
# surface the language bindings (an N-API native addon, an
# emscripten `compiler.wasm`) build on without binding the C++ class
# layout directly.  Thin marshalling shim: depends only on the
# public compiler surface (//compiler:{compiler,program}) plus
# //shared:type for the variable-declaration type vocabulary.
#
# Scoped to //:internal — the first-party bindings packages consume
# it (they are in the //:internal package_group); it is not part of
# the external public API contract.

cc_library(
    name = "cel_capi",
    srcs = ["cel_capi.cc"],
    hdrs = ["cel_capi.h"],
    visibility = ["//:internal"],
    deps = [
        "//compiler:compiler",
        "//compiler:program",
        "//shared:type",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/types:span",
        "@com_google_protobuf//:protobuf",
    ],
)

cc_test(
    name = "cel_capi_test",
    size = "small",
    srcs = ["cel_capi_test.cc"],
    deps = [
        ":cel_capi",
        "@com_google_googletest//:gtest_main",
        "@com_google_protobuf//:protobuf",
    ],
)

# compiler.wasm — the CEL compiler cross-compiled to wasm32-wasi so a
# browser (or any WASI host) can compile CEL → Program with no native
# toolchain.  `compiler_wasm_exports.cc` adds a small JS-friendly `cew_*`
# export layer over the C ABI (the module is a reactor; JS marshals
# strings through linear memory and calls the exports), and
# `wasm_cpp_cc_binary` builds it under the wasm toolchain with C++
# exceptions/RTTI enabled for the cel-cpp + Binaryen deps.  `manual` so
# `//...` (host config) never tries to build the wasm binary directly.
cc_binary(
    name = "compiler_wasm.bin",
    srcs = ["compiler_wasm_exports.cc"],
    linkopts = [
        "-Wl,--export=cew_alloc",
        "-Wl,--export=cew_free",
        "-Wl,--export=cew_compile",
        "-Wl,--export=cew_compile_opts",
        "-Wl,--export=cew_program",
        "-Wl,--export=cew_program_len",
        "-Wl,--export=cew_error",
        "-Wl,--export=cew_reset",
        # The toolchain links with -nostartfiles (no reactor crt), so the
        # C++ static constructors (protobuf descriptor registration,
        # cel-cpp global registries) are not auto-run by an `_initialize`.
        # Export wasm-ld's ctor runner so the JS host calls it once after
        # instantiation, before any cew_* call.
        "-Wl,--export=__wasm_call_ctors",
    ],
    tags = ["manual"],
    visibility = ["//:internal"],
    deps = [":cel_capi"],
)

wasm_cpp_cc_binary(
    name = "compiler_wasm",
    binary = ":compiler_wasm.bin",
    tags = ["manual"],
    visibility = ["//:internal"],
)
