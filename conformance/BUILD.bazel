load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//compiler_v2:__subpackages__"])

# Upstream conformance suite glue.  `runner` wraps one SimpleTest as
# a pipeline invocation; `run_conformance` walks the whole
# `tests/simple/testdata/` corpus and tallies outcomes.  See
# README.md for the per-fixture inventory this binary feeds, and
# doc/implementation-plan/testing-checklist.md for the milestone
# coverage rows.

cc_library(
    name = "runner",
    srcs = ["runner.cc"],
    hdrs = ["runner.h"],
    deps = [
        ":binding_marshal",
        "//eval:activation",
        "//eval:cel_host",
        "//compiler:compiler",
        "//eval:engine",
        "//eval:instance",
        "//compiler:program",
        "//eval:value",
        "//compiler/frontend:status_tags",
        # `TestAllTypes` descriptors registered at load time so
        # TextFormat::Parse can resolve google.protobuf.Any values
        # in the conformance textprotos (block_ext / dynamic / enums
        # / parse / proto2 / proto2_ext / proto3 / type_deduction
        # all embed Any<proto{2,3}.TestAllTypes>).
        "//proto/cel/expr/conformance/proto2:test_all_types_cc_proto",
        "//proto/cel/expr/conformance/proto3:test_all_types_cc_proto",
        "//proto/cel/expr:eval_cc_proto",
        "//proto/cel/expr:value_cc_proto",
        "//proto/cel/expr/conformance/test:simple_cc_proto",
        "@com_google_absl//absl/base:no_destructor",
        "@com_google_absl//absl/container:flat_hash_set",
        "@com_google_absl//absl/log:absl_check",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_protobuf//:protobuf",
    ],
)

# Marshaller from test-fixture proto shapes (`cel.expr.ExprValue`,
# `cel.expr.Decl`) to the public `cel::` surface (`cel::Value`,
# `cel::Activation`, `Compiler::Builder::DeclareVariable`).  Lives
# in its own translation unit so the unit tests can exercise the
# scalar-only marshal contract without pulling in the wasmtime
# runner.
cc_library(
    name = "binding_marshal",
    srcs = ["binding_marshal.cc"],
    hdrs = ["binding_marshal.h"],
    deps = [
        "//eval:activation",
        "//compiler:compiler",
        "//common:type",
        "//eval:value",
        "//proto/cel/expr:checked_cc_proto",
        "//proto/cel/expr:eval_cc_proto",
        "//proto/cel/expr:value_cc_proto",
        "//proto/cel/expr/conformance/test:simple_cc_proto",
        "@com_google_absl//absl/base:core_headers",
        "@com_google_absl//absl/log:absl_check",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
    ],
)

cc_test(
    name = "runner_test",
    srcs = ["runner_test.cc"],
    deps = [
        ":runner",
        "//eval:error",
        "//eval:value",
        "//proto/cel/expr:eval_cc_proto",
        "//proto/cel/expr/conformance/test:simple_cc_proto",
        "@com_google_absl//absl/log:absl_check",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/strings",
        "@com_google_googletest//:gtest_main",
        "@com_google_protobuf//:protobuf",
    ],
)

cc_test(
    name = "binding_marshal_test",
    srcs = ["binding_marshal_test.cc"],
    deps = [
        ":binding_marshal",
        "//eval:activation",
        # M7: Value::OwnedMessage impl lives in cel_host.cc (needs
        # OwnedProtoBacking's complete definition).  Link cel_host
        # so binding_marshal_test resolves the symbol.
        "//eval:cel_host",
        "//eval:value",
        "//proto/cel/expr:checked_cc_proto",
        "//proto/cel/expr:eval_cc_proto",
        "//proto/cel/expr:value_cc_proto",
        "//proto/cel/expr/conformance/test:simple_cc_proto",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:status_matchers",
        "@com_google_googletest//:gtest_main",
        "@com_google_protobuf//:protobuf",
    ],
)

# Textproto fixtures fan in via `data`; the runner ifstreams them
# from workspace-relative paths (Bazel lands them at
# runfiles/_main/tests/...).
#
# Three lists must stay in sync when adding or removing a fixture:
#   1. `SIMPLE_TESTDATA` below — the `data =` attribute makes the
#      file available in the runfiles tree.
#   2. `DefaultCorpus()` in `run_conformance.cc` — the runtime
#      list the binary iterates over.
#   3. `ForceLinkFixtureDescriptors` in `runner.cc` — needed only
#      if the new fixture embeds `google.protobuf.Any` values of
#      types not already force-linked.
#
# Future work: replace these three with a single source of truth
# (a genrule emitting a .inc) — tracked in `README.md::Future work`.
SIMPLE_TESTDATA = [
    "//spec/tests/simple:testdata/basic.textproto",
    "//spec/tests/simple:testdata/bindings_ext.textproto",
    "//spec/tests/simple:testdata/block_ext.textproto",
    "//spec/tests/simple:testdata/comparisons.textproto",
    "//spec/tests/simple:testdata/conversions.textproto",
    "//spec/tests/simple:testdata/dynamic.textproto",
    "//spec/tests/simple:testdata/encoders_ext.textproto",
    "//spec/tests/simple:testdata/enums.textproto",
    "//spec/tests/simple:testdata/fields.textproto",
    "//spec/tests/simple:testdata/fp_math.textproto",
    "//spec/tests/simple:testdata/integer_math.textproto",
    "//spec/tests/simple:testdata/lists.textproto",
    "//spec/tests/simple:testdata/logic.textproto",
    "//spec/tests/simple:testdata/macros.textproto",
    "//spec/tests/simple:testdata/macros2.textproto",
    "//spec/tests/simple:testdata/math_ext.textproto",
    "//spec/tests/simple:testdata/namespace.textproto",
    "//spec/tests/simple:testdata/network_ext.textproto",
    "//spec/tests/simple:testdata/optionals.textproto",
    "//spec/tests/simple:testdata/parse.textproto",
    "//spec/tests/simple:testdata/plumbing.textproto",
    "//spec/tests/simple:testdata/proto2.textproto",
    "//spec/tests/simple:testdata/proto2_ext.textproto",
    "//spec/tests/simple:testdata/proto3.textproto",
    "//spec/tests/simple:testdata/string.textproto",
    "//spec/tests/simple:testdata/string_ext.textproto",
    "//spec/tests/simple:testdata/timestamps.textproto",
    "//spec/tests/simple:testdata/type_deduction.textproto",
    "//spec/tests/simple:testdata/unknowns.textproto",
    "//spec/tests/simple:testdata/wrappers.textproto",
]

cc_binary(
    name = "run_conformance",
    srcs = ["run_conformance.cc"],
    data = SIMPLE_TESTDATA,
    tags = ["manual"],
    deps = [
        ":runner",
        "//compiler:compiler",
        "//eval:engine",
        "//proto/cel/expr/conformance/test:simple_cc_proto",
        "@com_google_absl//absl/flags:flag",
        "@com_google_absl//absl/flags:parse",
        "@com_google_absl//absl/log:absl_check",
        "@com_google_absl//absl/strings",
    ],
)
