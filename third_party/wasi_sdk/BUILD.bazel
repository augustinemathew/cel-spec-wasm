# Top-level package for the wasi-sdk dependency.  The build rules each
# per-platform `@wasi_sdk_*` repository exposes live in
# BUILD.external.bazel, which is injected by the `http_archive` calls
# in //:MODULE.bazel.
#
# This package serves two consumers:
#
#   1. Legacy genrule consumers (`//compiler_v2/runtime:cel_runtime_wasm_file`)
#      that reference `:clang`, `:ar`, etc. as `$(execpath ...)` tools.
#      Aliased to the per-host `@wasi_sdk_*` filegroups below.
#
#   2. The wasm32-wasi-threads `cc_toolchain` registration (Phase C).
#      Modern bazel cc_library / cc_binary targets that opt into the
#      wasm cross-compile via `--platforms=//third_party/wasi_sdk:wasm32_wasi`.
#      The toolchain config, three sh wrapper scripts (`wasm_clang.sh`,
#      `wasm_ar.sh`, `wasm_nm.sh`), and the `cc_toolchain` /
#      `toolchain` / `platform` rules live here.  Validated by
#      probes E3-E8 (`doc/implementation-plan/rewrite/phase-c-probes/`).
#
# Cross-platform note.  Both the aliases and the cc_toolchain default
# to `wasi_sdk_darwin_arm64`.  When CI extends to linux/x86_64 hosts,
# the natural pattern is one `toolchain()` registration per host with
# `exec_compatible_with` selecting at resolution time — see
# `phase-c-plan.md` §7.6.

load("@rules_cc//cc:defs.bzl", "cc_binary")
load(":cc_toolchain_config.bzl", "cc_toolchain_config")

package(default_visibility = ["//visibility:public"])

# --- Legacy aliases (genrule consumers) -----------------------------------

alias(
    name = "clang",
    actual = "@wasi_sdk_darwin_arm64//:clang",
)

alias(
    name = "clang++",
    actual = "@wasi_sdk_darwin_arm64//:clang++",
)

alias(
    name = "ar",
    actual = "@wasi_sdk_darwin_arm64//:ar",
)

alias(
    name = "ranlib",
    actual = "@wasi_sdk_darwin_arm64//:ranlib",
)

alias(
    name = "sysroot",
    actual = "@wasi_sdk_darwin_arm64//:sysroot",
)

alias(
    name = "all",
    actual = "@wasi_sdk_darwin_arm64//:all",
)

# --- wasm32-wasi-threads cc_toolchain registration ------------------------

# All wasi-sdk tools + sysroot are needed at action time.
filegroup(
    name = "wasi_sdk_all",
    srcs = ["@wasi_sdk_darwin_arm64//:all"],
)

# tool_paths in cc_toolchain_config are package-relative.  We place
# wrapper sh scripts in this package; each execs the real wasi-sdk
# binary by absolute path (computed via `dirname $0` + ../../external/).
filegroup(
    name = "tool_wrappers",
    srcs = [
        "wasm_ar.sh",
        "wasm_clang.sh",
        "wasm_nm.sh",
    ],
)

filegroup(
    name = "tool_inputs",
    srcs = [
        ":tool_wrappers",
        ":wasi_sdk_all",
    ],
)

# Exec-root-relative paths into the bazel-fetched wasi_sdk archive.
# cxx_builtin_include_directories are exec-root-relative paths the
# cc rules accept as system include roots.
cc_toolchain_config(
    name = "wasm32_wasi_config",
    clang_path = "wasm_clang.sh",
    ar_path = "wasm_ar.sh",
    nm_path = "wasm_nm.sh",
    sysroot_path = "external/_main~_repo_rules~wasi_sdk_darwin_arm64/share/wasi-sysroot",
    builtin_include_directories = [
        # libc++ headers live under <sysroot>/include/<target>/c++/v1/.
        # Listed FIRST so they take precedence over the C-only sysroot.
        "external/_main~_repo_rules~wasi_sdk_darwin_arm64/share/wasi-sysroot/include/wasm32-wasi-threads/c++/v1",
        # wasi-libc headers (per-target).
        "external/_main~_repo_rules~wasi_sdk_darwin_arm64/share/wasi-sysroot/include/wasm32-wasi-threads",
        # Generic sysroot includes (target-independent wasi-libc bits).
        "external/_main~_repo_rules~wasi_sdk_darwin_arm64/share/wasi-sysroot/include",
        # Clang's internal builtin headers (stddef.h etc.).
        "external/_main~_repo_rules~wasi_sdk_darwin_arm64/lib/clang/19/include",
    ],
)

cc_toolchain(
    name = "wasm32_wasi_cc_toolchain",
    all_files = ":tool_inputs",
    ar_files = ":tool_inputs",
    compiler_files = ":tool_inputs",
    dwp_files = ":tool_inputs",
    linker_files = ":tool_inputs",
    objcopy_files = ":tool_inputs",
    strip_files = ":tool_inputs",
    toolchain_config = ":wasm32_wasi_config",
    toolchain_identifier = "wasm32_wasi",
)

toolchain(
    name = "wasm32_wasi_toolchain",
    exec_compatible_with = [],
    target_compatible_with = [
        "@platforms//cpu:wasm32",
        "@platforms//os:wasi",
    ],
    toolchain = ":wasm32_wasi_cc_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

platform(
    name = "wasm32_wasi",
    constraint_values = [
        "@platforms//cpu:wasm32",
        "@platforms//os:wasi",
    ],
)
