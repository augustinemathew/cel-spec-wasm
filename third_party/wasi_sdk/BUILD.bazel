# Top-level package for the wasi-sdk dependency.  The build rules each
# per-platform `@wasi_sdk_*` repository exposes live in
# BUILD.external.bazel, which is injected by the `http_archive` calls
# in //:MODULE.bazel.
#
# This package serves two consumers:
#
#   1. Legacy genrule consumers that reference `:clang`, `:ar`, etc.
#      as `$(execpath ...)` tools.  No live consumer remains (the old
#      `cel_runtime_wasm_file` genrule was replaced by a wasm_binary
#      transition target), but the aliases are kept non-broken so a
#      future genrule can use them.  They dispatch to the host archive
#      via `select()`.
#
#   2. The wasm32-wasi-threads `cc_toolchain` registration.  Modern
#      bazel cc_library / cc_binary targets opt into the wasm
#      cross-compile via `--platforms=//third_party/wasi_sdk:wasm32_wasi`.
#      The toolchain config, three sh wrapper scripts (`wasm_clang.sh`,
#      `wasm_ar.sh`, `wasm_nm.sh`), and the `cc_toolchain` /
#      `toolchain` / `platform` rules live here.  Validated by
#      probes E3-E8 (`doc/implementation-plan/rewrite/phase-c-probes/`).
#
# Cross-platform.  Four wasm-cross toolchains are registered — one per
# build host (darwin/linux × arm64/x86_64) — each with
# `exec_compatible_with` pinned to that host.  Bazel toolchain
# resolution auto-selects the one matching the build host, so a Linux
# checkout and a macOS checkout each pick up the right wasi-sdk archive
# with no `select()` in the toolchain itself.  The `wasm_wasi_toolchains`
# macro below generates all four from one call.  See
# `phase-c-plan.md` §7.6.

load(":cc_toolchain_config.bzl", "wasm_wasi_toolchains")

package(default_visibility = ["//visibility:public"])

# --- Per-host wasm32-wasi-threads cc_toolchain registration ---------------
#
# Generates, for each (os, cpu) host:
#   - a cc_toolchain_config keyed on that host's `@wasi_sdk_<host>` repo,
#   - a cc_toolchain,
#   - a toolchain() with `exec_compatible_with = [host os + cpu]` and
#     `target_compatible_with = [wasm32, wasi]`.
# The wrapper sh scripts and `wasm32_wasi` platform are shared across
# hosts (the scripts glob the single fetched archive at action time).
wasm_wasi_toolchains(name = "wasm32_wasi")

# tool_paths in cc_toolchain_config are package-relative.  We place
# wrapper sh scripts in this package; each execs the real wasi-sdk
# binary by absolute path (glob of the single fetched archive).
filegroup(
    name = "tool_wrappers",
    srcs = [
        "wasm_ar.sh",
        "wasm_clang.sh",
        "wasm_nm.sh",
    ],
)

platform(
    name = "wasm32_wasi",
    constraint_values = [
        "@platforms//cpu:wasm32",
        "@platforms//os:wasi",
        ":wasi_threads_on",
    ],
)

# Threading-mode constraint carried by the wasm32_wasi platform and
# the wasm32-wasi-threads cc_toolchains.  The bazel solver inspects
# `target_compatible_with` on the platform and the toolchains and
# picks the matching pair.
constraint_setting(name = "wasi_threads")
constraint_value(
    name = "wasi_threads_on",
    constraint_setting = ":wasi_threads",
)
