# Injected as the top-level BUILD file for each per-platform
# `@wasi_sdk_{darwin,linux}_{arm64,x86_64}` repository.  Exposes the
# wasi-sdk tarball's binaries as bazel filegroups so genrules can
# reference them via `$(execpath @wasi_sdk_<plat>//:clang)` etc.
#
# The platform-aware `@wasi_sdk//:clang` alias in
# //third_party/wasi_sdk:BUILD.bazel dispatches to the right one
# of these per @platforms//os × @platforms//cpu.

package(default_visibility = ["//visibility:public"])

# The sysroot tree: wasi-libc headers + libc/libc++ static archives.
# Passed via --sysroot=$(execpath @wasi_sdk//:sysroot) at compile time.
# Everything in the SDK — used by genrules that need the whole tree
# (e.g. clang's lib/clang/19/lib/wasi/* runtime libraries).
filegroup(
    name = "all",
    srcs = glob(["**/*"], exclude = ["**/BUILD*"], allow_empty = True),
)
