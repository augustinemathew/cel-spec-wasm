# Host-selected wasm-tools CLI.  Same shape as
# //third_party/wit_bindgen — see its BUILD.bazel for prose.

package(default_visibility = ["//visibility:public"])

exports_files(["BUILD.external.bazel"])

alias(
    name = "wasm-tools",
    actual = select({
        ":host_darwin_arm64": "@wasm_tools_darwin_arm64//:wasm-tools",
        ":host_darwin_x86_64": "@wasm_tools_darwin_x86_64//:wasm-tools",
        ":host_linux_arm64": "@wasm_tools_linux_arm64//:wasm-tools",
        ":host_linux_x86_64": "@wasm_tools_linux_x86_64//:wasm-tools",
    }),
)

config_setting(
    name = "host_darwin_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:arm64",
    ],
)

config_setting(
    name = "host_darwin_x86_64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "host_linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
)

config_setting(
    name = "host_linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)
