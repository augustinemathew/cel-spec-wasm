Purpose: lets absl/synchronization compile for wasm32-wasip2 (threadless libc++).

`mutex.cc` includes `<thread>` solely for `std::this_thread::yield()`
in the weak `AbslInternalMutexYield` hook.  The Component-Model target
is single-threaded (see abseil-cpp-wasm-cctz-mutex.patch for why), so
that sysroot's libc++ ships no `<thread>` and the file failed with
"no member named 'this_thread' in namespace 'std'".

There is no other thread to yield to on that target, so the hook body
becomes empty there.  Everything else in absl::Mutex is untouched.

--- a/absl/synchronization/mutex.cc
+++ b/absl/synchronization/mutex.cc
@@ -38,7 +38,9 @@
 #include <cstddef>
 #include <cstdlib>
 #include <cstring>
+#if !defined(__wasm__) && !defined(__wasi__)
 #include <thread>  // NOLINT(build/c++11)
+#endif
 
 #include "absl/base/attributes.h"
 #include "absl/base/call_once.h"
@@ -74,7 +76,12 @@
 
 extern "C" {
 ABSL_ATTRIBUTE_WEAK void ABSL_INTERNAL_C_SYMBOL(AbslInternalMutexYield)() {
+#if defined(__wasm__) || defined(__wasi__)
+  // Single-threaded target (see the cctz patch): there is no other
+  // thread to yield to, and <thread> is absent from this sysroot.
+#else
   std::this_thread::yield();
+#endif
 }
 }  // extern "C"
 
