# Host-selected wit-bindgen CLI.
#
# Four per-host `@wit_bindgen_<host>` archives are declared in
# //:MODULE.bazel; each exposes the executable via the build_file at
# `BUILD.external.bazel` in this package.  `:wit-bindgen` aliases to
# the one matching the build host, so consumers — the
# `cel_wasm_component` Starlark macro at
# //bazel:cel_wasm_component.bzl — just depend on
# `//third_party/wit_bindgen:wit-bindgen` regardless of platform.

package(default_visibility = ["//visibility:public"])

exports_files(["BUILD.external.bazel"])

alias(
    name = "wit-bindgen",
    actual = select({
        ":host_darwin_arm64": "@wit_bindgen_darwin_arm64//:wit-bindgen",
        ":host_darwin_x86_64": "@wit_bindgen_darwin_x86_64//:wit-bindgen",
        ":host_linux_arm64": "@wit_bindgen_linux_arm64//:wit-bindgen",
        ":host_linux_x86_64": "@wit_bindgen_linux_x86_64//:wit-bindgen",
    }),
)

config_setting(
    name = "host_darwin_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:arm64",
    ],
)

config_setting(
    name = "host_darwin_x86_64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "host_linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
)

config_setting(
    name = "host_linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)
