load("@com_google_protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
load("@com_google_protobuf//bazel:proto_library.bzl", "proto_library")

package(default_visibility = ["//visibility:public"])

# Schema of the `cel.abi` custom section emitted by the compiler.
# Fresh v2 schema — decoupled from v1's compiler/codegen/cel_abi.proto.
# See cel_abi.proto for the rationale and field-by-field docs.
proto_library(
    name = "cel_abi_proto",
    srcs = ["cel_abi.proto"],
)

cc_proto_library(
    name = "cel_abi_cc_proto",
    deps = [":cel_abi_proto"],
)

# Schema of the generated runtime-helper catalogue.  The generated
# `CelRuntimeFunction` / `CelRuntimeCatalogue` messages ARE the catalogue
# types used throughout the C++ surface.  See `runtime_catalogue.proto`.
proto_library(
    name = "runtime_catalogue_proto",
    srcs = ["runtime_catalogue.proto"],
)

cc_proto_library(
    name = "runtime_catalogue_cc_proto",
    deps = [":runtime_catalogue_proto"],
)

# The generated `CelRuntimeCatalogue` textproto.  Produced by
# `//bazel:gen_runtime_catalogue` from the `// cel:codegen-export`
# markers in the runtime C sources (the single source of truth for the
# `cel`-module helper set).
genrule(
    name = "runtime_catalogue_textproto",
    srcs = ["//runtime:runtime_c_sources"],
    outs = ["runtime_catalogue.textproto"],
    cmd = "$(location //bazel:gen_runtime_catalogue) --mode textproto " +
          "--out $@ $(locations //runtime:runtime_c_sources)",
    tools = ["//bazel:gen_runtime_catalogue"],
)

# Embed the generated textproto as a string literal so
# `runtime_catalogue.cc` parses it with no runfiles dependency.  Mirrors
# `//runtime:cel_runtime_wasm_bytes_cc`'s embed-into-.cc pattern.
genrule(
    name = "runtime_catalogue_textproto_cc",
    srcs = [":runtime_catalogue_textproto"],
    outs = ["runtime_catalogue_textproto.cc"],
    cmd = """
{
  echo '// Auto-generated by //abi:runtime_catalogue_textproto_cc.'
  echo '// Do not edit by hand; re-run the genrule to refresh.'
  echo '#include "abi/runtime_catalogue_textproto.h"'
  echo
  echo '#include "absl/strings/string_view.h"'
  echo
  echo 'namespace celwasm::abi {'
  echo 'namespace {'
  echo 'constexpr unsigned char kTextproto[] = {'
  od -An -tu1 -v $(location :runtime_catalogue_textproto) \
    | awk '{ for (i=1;i<=NF;i++) printf "0x%02x,", $$i; print "" }'
  echo '};'
  echo '}  // namespace'
  echo
  echo 'absl::string_view RuntimeCatalogueTextproto() {'
  echo '  return absl::string_view('
  echo '      reinterpret_cast<const char*>(kTextproto), sizeof(kTextproto));'
  echo '}'
  echo
  echo '}  // namespace celwasm::abi'
} > $@
""",
)

cc_library(
    name = "runtime_catalogue_textproto_embed",
    srcs = [":runtime_catalogue_textproto_cc"],
    hdrs = ["runtime_catalogue_textproto.h"],
    deps = ["@com_google_absl//absl/strings"],
)

# The runtime-helper catalogue.  The `cel`-module set is generated from
# the C-source markers (embedded textproto, parsed at first use); the
# `cel_host` / `cel_env` import sets are hand-maintained.  See
# `runtime_catalogue.h` for the full design.
cc_library(
    name = "runtime_catalogue",
    srcs = ["runtime_catalogue.cc"],
    hdrs = ["runtime_catalogue.h"],
    deps = [
        ":cel_abi_cc_proto",
        ":runtime_catalogue_cc_proto",
        ":runtime_catalogue_textproto_embed",
        "@com_google_absl//absl/base:core_headers",
        "@com_google_absl//absl/base:no_destructor",
        "@com_google_absl//absl/base:nullability",
        "@com_google_absl//absl/container:flat_hash_map",
        "@com_google_absl//absl/log:absl_check",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/types:span",
        "@com_google_protobuf//:protobuf",
    ],
)

cc_test(
    name = "runtime_catalogue_test",
    srcs = ["runtime_catalogue_test.cc"],
    deps = [
        ":cel_abi_cc_proto",
        ":runtime_catalogue",
        ":runtime_catalogue_cc_proto",
        "@com_google_absl//absl/container:flat_hash_set",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/strings",
        "@com_google_googletest//:gtest_main",
    ],
)

# Compile-side: build a `CelAbi` from the StaticLayout.  Consumed by
# compile.cc after LayoutPass + LowerToEvalFunction.  Pair with
# eval/internal/abi_decode (load-time decoder).
cc_library(
    name = "cel_abi_emit",
    srcs = ["cel_abi_emit.cc"],
    hdrs = ["cel_abi_emit.h"],
    deps = [
        ":cel_abi_cc_proto",
        ":runtime_catalogue",
        "//compiler/codegen:expr_lower",
        "//compiler/codegen:layout_pass",
        "@com_google_absl//absl/base:core_headers",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/types:span",
    ],
)

cc_test(
    name = "cel_abi_emit_test",
    srcs = ["cel_abi_emit_test.cc"],
    deps = [
        ":cel_abi_cc_proto",
        ":cel_abi_emit",
        "//compiler/codegen:expr_lower",
        "//compiler/codegen:layout_pass",
        "//compiler/codegen:resolve_pass",
        "//compiler/frontend:parse_and_check",
        "//compiler/ir:annotations",
        "//compiler/ir:typed_ast",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:status_matchers",
        "@com_google_absl//absl/types:span",
        "@com_google_googletest//:gtest_main",
    ],
)
