package(default_visibility = ["//visibility:public"])

# The wasm binary-format layer: preamble classification, LEB128
# codec, top-level custom-section read/write over raw bytes.  The
# ONLY first-party code allowed to know wasm binary framing
# (feature-pipeline-checklist §2.7).  Deliberately absl-only — no
# Binaryen, no wasmtime, no proto — so it sits below both compiler/
# and eval/.  First-party internal, not public API.
cc_library(
    name = "wasm_binary",
    srcs = ["wasm_binary.cc"],
    hdrs = ["wasm_binary.h"],
    visibility = ["//:internal"],
    deps = [
        "@com_google_absl//absl/base:core_headers",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/types:span",
    ],
)

cc_test(
    name = "wasm_binary_test",
    size = "small",
    srcs = ["wasm_binary_test.cc"],
    deps = [
        ":wasm_binary",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:status_matchers",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/types:span",
        "@com_google_googletest//:gtest_main",
    ],
)

# `Plugin` — the self-describing wasm plugin artifact: Component-Model
# bytes + the embedded `cel.fns` declaration text, parsed + validated
# at Load.  Public API (part of the curated //abi surface — both
# `Compiler::Builder::Use` and `Engine::Use` take `const Plugin&`).
# The abi → //compiler/celfn edge is data-vocabulary only, sanctioned
# by m35-plugin-ergonomics.md §3.1 (same class of edge eval already
# holds on the compiler side).
cc_library(
    name = "plugin",
    srcs = ["plugin.cc"],
    hdrs = ["plugin.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":wasm_binary",
        "//abi/internal:sha256",
        "//compiler/celfn:function_library",
        "@com_google_absl//absl/log:absl_check",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/types:span",
    ],
)

