load("@com_google_protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
load("@com_google_protobuf//bazel:proto_library.bzl", "proto_library")

package(default_visibility = ["//visibility:public"])

# Schema of the `cel.abi` custom section emitted by the compiler.
# Fresh v2 schema — decoupled from v1's compiler/codegen/cel_abi.proto.
# See cel_abi.proto for the rationale and field-by-field docs.
proto_library(
    name = "cel_abi_proto",
    srcs = ["cel_abi.proto"],
)

cc_proto_library(
    name = "cel_abi_cc_proto",
    deps = [":cel_abi_proto"],
)

# Single source of truth for the wasm imports an emitted expr
# module declares.  Three namespaces (cel, cel_host, cel_env) plus
# the per-program cel_fn namespace for custom fns.  Replaces three
# previously hand-maintained surfaces (engine.cc::kRuntimeExports,
# runtime/BUILD.bazel `--export=` flags, overload_table.cc::
# InferHelperArity).  See `runtime_catalogue.h` for the full design.
cc_library(
    name = "runtime_catalogue",
    srcs = ["runtime_catalogue.cc"],
    hdrs = ["runtime_catalogue.h"],
    deps = [
        ":cel_abi_cc_proto",
        "@com_google_absl//absl/base:core_headers",
        "@com_google_absl//absl/base:no_destructor",
        "@com_google_absl//absl/base:nullability",
        "@com_google_absl//absl/container:flat_hash_map",
        "@com_google_absl//absl/log:absl_check",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/types:span",
    ],
)

cc_test(
    name = "runtime_catalogue_test",
    srcs = ["runtime_catalogue_test.cc"],
    deps = [
        ":runtime_catalogue",
        "@com_google_absl//absl/container:flat_hash_set",
        "@com_google_googletest//:gtest_main",
    ],
)

# Tripwire: asserts the `[codegen-helpers]` section of
# `runtime/wasm_exports.txt` is set-identical to
# `abi::CelRuntimeHelpers()`.  Closes both directions of drift —
# catalogue ⊆ text-file (else linker dead-strips on the wasm side)
# and text-file ⊆ catalogue (else codegen has no metadata to emit
# the import).  Replaces the pre-refactor BUILD-parsing form.
cc_test(
    name = "runtime_catalogue_consistency_test",
    srcs = ["runtime_catalogue_consistency_test.cc"],
    data = ["//runtime:wasm_exports.txt"],
    deps = [
        ":runtime_catalogue",
        "@com_google_absl//absl/container:flat_hash_set",
        "@com_google_absl//absl/strings",
        "@com_google_googletest//:gtest_main",
    ],
)

# Compile-side: build a `CelAbi` from the StaticLayout.  Consumed by
# compile.cc after LayoutPass + LowerToEvalFunction.  Pair with
# eval/internal/abi_decode (load-time decoder).
cc_library(
    name = "cel_abi_emit",
    srcs = ["cel_abi_emit.cc"],
    hdrs = ["cel_abi_emit.h"],
    deps = [
        ":cel_abi_cc_proto",
        ":runtime_catalogue",
        "//compiler/codegen:expr_lower",
        "//compiler/codegen:layout_pass",
        "@com_google_absl//absl/base:core_headers",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/types:span",
    ],
)

cc_test(
    name = "cel_abi_emit_test",
    srcs = ["cel_abi_emit_test.cc"],
    deps = [
        ":cel_abi_cc_proto",
        ":cel_abi_emit",
        "//compiler/codegen:expr_lower",
        "//compiler/codegen:layout_pass",
        "//compiler/codegen:resolve_pass",
        "//compiler/frontend:parse_and_check",
        "//compiler/ir:annotations",
        "//compiler/ir:typed_ast",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:status_matchers",
        "@com_google_absl//absl/types:span",
        "@com_google_googletest//:gtest_main",
    ],
)
