# First-party, dependency-independent Starlark / build tooling (the
# top-level `bazel/` dir mandated by CLAUDE.md — first-party reusable
# build assets live here, never scattered into package dirs and never in
# `third_party/`).

load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_python//python:defs.bzl", "py_binary")

package(default_visibility = ["//visibility:public"])

# Tiny header that surfaces `kTestLinkMode` (selected by the
# `CELWASM_TEST_USE_STATIC_LINK_MODE` compile-time macro that
# `link_mode_test.bzl::link_mode_cc_test` injects on its `_static`
# emission).  Used by unit tests under `//compiler/...` and
# `//eval/...` that exercise `Compile()` and want their bodies to
# run under both link modes.
cc_library(
    name = "link_mode_test_helpers",
    hdrs = ["link_mode_test_helpers.h"],
    deps = ["//compiler:compiler"],
)

# The cel_wasm_component Starlark macro — drives the full hermetic
# component build (cel generate → wit-bindgen c → wasi-sdk cc_binary
# → wasm-tools component new) from a single celfn .idl + author
# user_fns.cc.  See its docstring + m26 §6 for usage.
exports_files(["cel_wasm_component.bzl"])

# Derives the runtime-helper catalogue from the `cel_runtime` C source:
# every codegen-imported helper is marked `// cel:codegen-export` at its
# declaration, and this tool reads the marker (membership) plus the
# `void`/`uint32_t` signature (arity + return shape).  Two outputs:
#   --mode=textproto  -> the `CelRuntimeCatalogue` (`//abi`).
#   --mode=names      -> the codegen-helper `--export=` names (`//runtime`).
py_binary(
    name = "gen_runtime_catalogue",
    srcs = ["gen_runtime_catalogue.py"],
    visibility = ["//:internal"],
)
