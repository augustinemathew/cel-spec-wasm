load("@rules_cc//cc:defs.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])

# Bench targets are `manual`-tagged so they don't run in CI by default
# (the default `bazel test` run skips them).  Run explicitly when
# you want numbers:
#
#   bazel run -c opt //bench:kernel_bench
#   bazel run -c opt //bench:pipeline_bench
#
# Always pass `-c opt`; debug builds with sanitizers blow the timing
# numbers up by ~10x and are useless as a baseline.

# Deliverable A — runtime kernel microbenches.  Each BM_* function
# stages operands once outside the loop and times one tight call to a
# single cel_runtime.c helper.  Covers arithmetic, comparison,
# aggregate, 3VL, conversion, and string-op kernels.
cc_binary(
    name = "kernel_bench",
    srcs = ["kernel_bench.cc"],
    copts = ["-std=c++17"],
    tags = ["manual"],
    deps = [
        "//runtime:cel_runtime",
        "@com_google_absl//absl/strings",
        "@com_google_benchmark//:benchmark_main",
    ],
)

# Deliverable B — end-to-end pipeline wall-clock benches.  Measures
# the public Compiler::Compile + Engine::Plan + Instance::Eval surface
# with proper caching boundaries (Compiler shared across iterations of
# a Compile bench; Compile+Plan pre-staged for an Eval-only steady
# state bench).  One representative expression per AST kind.
cc_binary(
    name = "pipeline_bench",
    srcs = ["pipeline_bench.cc"],
    copts = ["-std=c++17"],
    tags = ["manual"],
    deps = [
        "//testdata:e2e_fixture_cc_proto",
        "//eval:activation",
        "//eval:cel_host",  # for Value::Message(proto)
        "//compiler:compiler",
        "//eval:engine",
        "//eval:instance",
        "//compiler:program",
        "//shared:type",
        "//eval:value",
        "@com_google_absl//absl/log:absl_check",
        "@com_google_absl//absl/strings",
        "@com_google_benchmark//:benchmark_main",
    ],
)


# Reports the wasm byte size of representative compiled programs at
# optimize_level 0 vs 2.  Used to populate the "Program size" table
# in the repo README.  Not a benchmark (no timing); just a
# size reporter.  Run with:
#   bazel run -c opt //bench:program_size_main
cc_binary(
    name = "program_size_main",
    srcs = ["program_size_main.cc"],
    copts = ["-std=c++17"],
    tags = ["manual"],
    deps = [
        "//eval:activation",
        "//compiler:compiler",
        "//compiler:program",
        "//shared:type",
        "//eval:value",
        "//compiler/frontend:parse_and_check",
        "//runtime:cel_runtime",
        "@com_google_cel_spec//proto/cel/expr:checked_cc_proto",
        "@cel-cpp//common:ast_proto",
        "@com_google_absl//absl/log:absl_check",
        "@com_google_absl//absl/strings",
    ],
)

# Proto crossing benches — copy-vs-pull cost for moving a proto
# message across an isolation boundary.  COPY-BY-VALUE benches
# (`BM_ProtoSerialize_*` / `BM_ProtoParse_*` / `BM_ProtoRoundTrip_*`)
# measure raw protobuf serialize/parse; PULL benches (`BM_Pull_*`)
# measure the per-field trampoline read end-to-end through
# `Instance::Eval`.  Run with:
#   bazel run -c opt //bench:proto_crossing_bench
cc_binary(
    name = "proto_crossing_bench",
    srcs = ["proto_crossing_bench.cc"],
    copts = ["-std=c++17"],
    tags = ["manual"],
    deps = [
        "//testdata:e2e_fixture_cc_proto",
        "//eval:activation",
        "//eval:cel_host",  # for Value::Message(proto)
        "//compiler:compiler",
        "//eval:engine",
        "//eval:instance",
        "//compiler:program",
        "//shared:type",
        "//eval:value",
        "@com_google_absl//absl/log:absl_check",
        "@com_google_absl//absl/strings",
        "@com_google_benchmark//:benchmark_main",
        "@com_google_protobuf//:protobuf",
    ],
)
