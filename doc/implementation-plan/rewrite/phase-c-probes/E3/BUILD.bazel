load("@rules_cc//cc:defs.bzl", "cc_binary")
load(":cc_toolchain_config.bzl", "cc_toolchain_config")

package(default_visibility = ["//visibility:private"])

# All wasi-sdk tools + sysroot are needed at action time.
filegroup(
    name = "wasi_sdk_all",
    srcs = ["@wasi_sdk_darwin_arm64//:all"],
)

# The toolchain config.  Paths are absolute into the bazel-fetched
# wasi_sdk_darwin_arm64 archive.  Genfiles + sandbox-respecting
# actions get this path via $(execpath ...)-style symlinks, but
# cc_toolchain tool_paths take plain strings — so we hardcode the
# external repo path here for the probe.  A production version
# would emit a wrapper sh script per tool that does the right
# thing across platforms.
cc_toolchain_config(
    name = "wasm32_wasi_config",
    clang_path = "wasm_clang.sh",
    ar_path = "wasm_ar.sh",
    nm_path = "wasm_nm.sh",
    # Note: builtin_sysroot must be relative to the exec root; we
    # pass the path inside the bazel external/ tree.  cxx_builtin_
    # include_directories are also exec-root-relative paths the
    # cc rules will accept as system include roots.
    sysroot_path = "external/_main~_repo_rules~wasi_sdk_darwin_arm64/share/wasi-sysroot",
    builtin_include_directories = [
        # libc++ headers live under <sysroot>/include/<target>/c++/v1/.
        # Listed FIRST so they take precedence over the C-only sysroot.
        "external/_main~_repo_rules~wasi_sdk_darwin_arm64/share/wasi-sysroot/include/wasm32-wasi-threads/c++/v1",
        # wasi-libc headers (per-target).
        "external/_main~_repo_rules~wasi_sdk_darwin_arm64/share/wasi-sysroot/include/wasm32-wasi-threads",
        # Generic sysroot includes (target-independent wasi-libc bits).
        "external/_main~_repo_rules~wasi_sdk_darwin_arm64/share/wasi-sysroot/include",
        # Clang's internal builtin headers (stddef.h etc.).
        "external/_main~_repo_rules~wasi_sdk_darwin_arm64/lib/clang/19/include",
    ],
)

filegroup(
    name = "tool_wrappers",
    srcs = [
        "wasm_ar.sh",
        "wasm_clang.sh",
        "wasm_nm.sh",
    ],
)

filegroup(
    name = "tool_inputs",
    srcs = [
        ":tool_wrappers",
        ":wasi_sdk_all",
    ],
)

cc_toolchain(
    name = "wasm32_wasi_cc_toolchain",
    all_files = ":tool_inputs",
    ar_files = ":tool_inputs",
    compiler_files = ":tool_inputs",
    dwp_files = ":tool_inputs",
    linker_files = ":tool_inputs",
    objcopy_files = ":tool_inputs",
    strip_files = ":tool_inputs",
    toolchain_config = ":wasm32_wasi_config",
    toolchain_identifier = "wasm32_wasi",
)

toolchain(
    name = "wasm32_wasi_toolchain",
    exec_compatible_with = [],
    target_compatible_with = [
        "@platforms//cpu:wasm32",
        "@platforms//os:wasi",
    ],
    toolchain = ":wasm32_wasi_cc_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

platform(
    name = "wasm32_wasi",
    constraint_values = [
        "@platforms//cpu:wasm32",
        "@platforms//os:wasi",
    ],
)

# The canary target.  Built via:
#   bazel build //doc/implementation-plan/rewrite/phase-c-probes/E3:hello_wasm \
#     --platforms=//doc/implementation-plan/rewrite/phase-c-probes/E3:wasm32_wasi \
#     --extra_toolchains=//doc/implementation-plan/rewrite/phase-c-probes/E3:wasm32_wasi_toolchain \
#     --incompatible_enable_cc_toolchain_resolution
cc_binary(
    name = "hello_wasm",
    srcs = ["hello_wasm.cc"],
    linkopts = [
        "-Wl,--export=add",
        "-Wl,--strip-all",
        "-Wl,--gc-sections",
    ],
    tags = ["manual"],
)
