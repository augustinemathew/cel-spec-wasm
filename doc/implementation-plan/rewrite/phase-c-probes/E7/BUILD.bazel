load("@rules_cc//cc:defs.bzl", "cc_binary")

package(default_visibility = ["//visibility:private"])

cc_binary(
    name = "kernels",
    srcs = ["kernels.cc"],
    deps = [
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/strings:str_format",
        "@com_google_absl//absl/time",
    ],
    linkopts = [
        "-Wl,--export=arena_reset",
        "-Wl,--export=arena_alloc",
        "-Wl,--export=parse_timestamp",
        "-Wl,--export=parse_duration",
        "-Wl,--export=format_timestamp",
        "-Wl,--export=format_duration",
        "-Wl,--export=strings_format_int",
        "-Wl,--strip-all",
        "-Wl,--gc-sections",
        "-Wl,--initial-memory=1048576",
    ],
    tags = ["manual"],
)
