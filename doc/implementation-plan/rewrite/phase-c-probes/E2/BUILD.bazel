load("@rules_cc//cc:defs.bzl", "cc_library")

# Probe E2 — build a parsetime.wasm via bazel genrule, mirroring E1's
# CMake-built baseline.  Uses the pre-built absl static archives under
# `wasm_compilation_experiments/exp1_re2/absl-install/`.
#
# The dev's pre-built absl install is NOT inside the bazel workspace
# (it lives under `wasm_compilation_experiments/`), so we reference
# the paths absolutely from inside the genrule shell command.  In a
# real Path C ship, those archives would be committed under
# `third_party/abseil-cpp-wasm/lib/` (or fetched via http_file from a
# release tarball) and exposed via `cc_import(static_library = …)`.
# For the probe, validating that bazel's sandbox can reach the
# tarball-style absl + drive wasi-sdk clang++ end-to-end is enough.

package(default_visibility = ["//visibility:private"])

# The genrule cannot inhale the 93 prebuilt absl archives without us
# committing them or fetching via http_file.  For the probe we just
# invoke wasi-sdk clang++ over the absolute path on disk — this is
# explicitly the Path-C "expedient but ugly" shape per §2 of the
# research brief.  bazel build still drives + caches the action.
genrule(
    name = "parsetime_wasm",
    srcs = [
        "parsetime_main.cc",
    ],
    outs = ["parsetime_via_bazel.wasm"],
    cmd = " ".join([
        # The wasi-sdk clang++ is in MODULE.bazel; reach it through
        # the bazel filegroup so the path is hermetic-ish.
        "$(execpath //third_party/wasi_sdk:clang++)",
        "--target=wasm32-wasi-threads",
        "-Oz",
        "-fno-rtti",
        "-pthread",
        "-D_WASI_EMULATED_SIGNAL",
        "-D_WASI_EMULATED_PROCESS_CLOCKS",
        "-D_WASI_EMULATED_MMAN",
        "-D_WASI_EMULATED_GETPID",
        # The absl-install headers + lib + cxa_stubs.o live under the
        # repo's wasm_compilation_experiments/ tree.  bazel does NOT
        # see those by default; the path below is the workspace-
        # relative path the genrule runs from when invoked.  Build
        # with `bazel build --spawn_strategy=local …` to escape the
        # sandbox, OR with `--sandbox_add_mount_pair=$PWD` so the
        # path is reachable.  For the probe we use local strategy.
        "-I $$PWD/wasm_compilation_experiments/exp1_re2/absl-install/include",
        "-Wl,--shared-memory",
        "-Wl,--max-memory=67108864",
        "-Wl,--export=parse",
        "-Wl,--strip-all",
        "-Wl,--gc-sections",
        "-nostartfiles",
        "-Wl,--no-entry",
        "$$PWD/wasm_compilation_experiments/exp1_re2/cxa_stubs.o",
        "$(SRCS)",
        "$$(ls $$PWD/wasm_compilation_experiments/exp1_re2/absl-install/lib/*.a | tr '\\n' ' ')",
        "-lwasi-emulated-signal",
        "-lwasi-emulated-process-clocks",
        "-lwasi-emulated-mman",
        "-lwasi-emulated-getpid",
        "-o $@",
    ]),
    tools = [
        "//third_party/wasi_sdk:clang++",
    ],
    tags = [
        "manual",
        "no-sandbox",
        "local",
    ],
)
