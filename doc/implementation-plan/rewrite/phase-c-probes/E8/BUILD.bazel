load("@rules_cc//cc:defs.bzl", "cc_binary")

package(default_visibility = ["//visibility:private"])

cc_binary(
    name = "re2_match",
    srcs = ["re2_match.cc"],
    deps = [
        "@com_google_absl//absl/strings",
        "@re2",
    ],
    linkopts = [
        "-Wl,--export=match",
        # Force-export ctor runner; without explicit invocation from
        # the wat driver, C++ static-storage objects (RE2's tables,
        # absl::Time globals) remain default-initialised.
        "-Wl,--export=__wasm_call_ctors",
        "-Wl,--export=__heap_base",
        "-Wl,--export=__data_end",
        "-Wl,--strip-all",
        # Note: NOT using --gc-sections; it can strip needed C++
        # static initialisers (RE2 / absl tables).
        "-Wl,--initial-memory=2097152",
    ],
    tags = ["manual"],
)
