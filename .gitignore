bazel-*
MODULE.bazel.lock

# cel-cpp is vendored via third_party/fetch_cel_cpp.sh against the pinned SHA
# in third_party/cel-cpp.sha.  We do not check it in.
third_party/cel-cpp/

# clang-tidy compile database — generated by scripts/refresh_compile_db.sh.
compile_commands.json

# clangd IDE cache.
.cache/

# scripts/build_lint_pch.sh output — speeds clang-tidy via -include-pch.
.lint-cache/

# Claude Code harness scratch (per-session lock files, scheduled-task state).
.claude/

# Local, per-developer Bazel overrides (see .bazelrc try-import).
user.bazelrc
