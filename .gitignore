bazel-*
MODULE.bazel.lock

# cel-cpp is vendored via third_party/fetch_cel_cpp.sh against the pinned SHA
# in third_party/cel-cpp.sha.  We do not check it in.
third_party/cel-cpp/

# clang-tidy compile database — generated by scripts/refresh_compile_db.sh.
compile_commands.json

# clangd IDE cache.
.cache/

# scripts/build_lint_pch.sh output — speeds clang-tidy via -include-pch.
.lint-cache/

# Claude Code harness scratch (per-session lock files, scheduled-task state).
.claude/

# Local, per-developer Bazel overrides (see .bazelrc try-import).
user.bazelrc

# Node deps for the TypeScript bindings — never checked in (large, and a
# `git add` of it would sweep thousands of files).  Restored via `npm ci`.
# The glob covers per-workspace-package node_modules (e.g. web/) too.
bindings/ts/**/node_modules/
bindings/ts/node_modules/

# TypeScript bindings build + coverage output — generated, never committed.
bindings/ts/**/dist/
bindings/ts/**/coverage/
bindings/ts/**/*.tsbuildinfo

# Rendered docs site (mkdocs build output) — published by
# .github/workflows/pages.yml, never committed.
/site/

# macOS Finder metadata.
.DS_Store
bindings/ts/web/.vite/*

# Build-generated wasm artifacts — produced from the bazel C++/wasm build
# (scripts/build-wasm-assets.sh, run by the web package's `predev` hook) and
# published as GitHub Release assets in CI. Not committed: they bloat git
# history and git handles large binaries poorly.
bindings/ts/compiler/wasm/compiler.wasm
bindings/ts/web/public/compiler.wasm
bindings/ts/web/public/cel_runtime.wasm
bindings/ts/eval/runtime/cel_runtime.wasm
