load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//compiler_v2:__subpackages__"])

# Host-side implementation of the `cel_env.cel_log` import.  Ported
# verbatim from v1 compiler/host/cel_log.
cc_library(
    name = "cel_log",
    srcs = ["cel_log.cc"],
    hdrs = ["cel_log.h"],
    deps = [
        "//runtime:cel_runtime",
        "@com_google_absl//absl/base:core_headers",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/strings:str_format",
        "@com_google_absl//absl/types:span",
        "//third_party/wasmtime:wasmtime",
    ],
)

cc_test(
    name = "cel_log_test",
    srcs = ["cel_log_test.cc"],
    deps = [
        ":cel_log",
        "//runtime:cel_runtime",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/types:span",
        "@com_google_googletest//:gtest_main",
    ],
)

# host_loader was deleted in the runtime-isolation rewrite.  Its
# role (instantiate the expr wasm + bind host imports + drive
# $eval) is now split across cel::Engine + cel::Instance under
# //compiler_v2/api/.  See
# doc/implementation-plan/rewrite/two-phase-runtime-isolation.md.
