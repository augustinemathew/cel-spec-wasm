load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

# Preview tool — dumps `<count>` generated expressions of
# `<target>` type at `<depth>` to stdout.  Useful for eyeballing
# what the grammar emits without writing a test.  Run as:
#   bazel run //e2e/fuzz:dump_samples -- bool 4 10
cc_binary(
    name = "dump_samples",
    srcs = ["dump_samples.cc"],
    tags = ["manual"],
    deps = [
        ":generator",
        ":grammar",
        ":grammar_aggregates",
        ":targets",
        "//shared:type",
        "@com_google_absl//absl/strings:string_view",
    ],
)

package(default_visibility = ["//visibility:public"])

# Smoke test proving the FuzzTest bzlmod wiring builds and runs
# end-to-end.  See fuzz_smoke_test.cc for the property body.
#
# Runs in unit-test mode under `bazel test`; turns into a coverage-
# guided fuzzer under `bazel run --config=fuzztest -- --fuzz=...`.
cc_test(
    name = "fuzz_smoke_test",
    size = "small",
    srcs = ["fuzz_smoke_test.cc"],
    deps = [
        "@com_google_googletest//:gtest",
        "@fuzztest//fuzztest",
        "@fuzztest//fuzztest:fuzztest_gtest_main",
    ],
)

# Typed attribute grammar — the data model for the CEL source
# generator.  See `doc/implementation-plan/rewrite/m27-pbt-cel-
# generator.md` §"The data model".  No fuzztest dep — the grammar
# is plain data that grammar_test (L1) and the future generator
# / property layers consume.
cc_library(
    name = "grammar",
    srcs = ["grammar.cc"],
    hdrs = ["grammar.h"],
    deps = [
        "//shared:type",
        "@com_google_absl//absl/container:flat_hash_map",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/strings:string_view",
    ],
)

# Slice B catalog — scalar-only typed-attribute grammar.  See
# `grammar_scalars.h` for the activation + production list.
cc_library(
    name = "grammar_scalars",
    srcs = ["grammar_scalars.cc"],
    hdrs = ["grammar_scalars.h"],
    deps = [
        ":grammar",
        "//shared:type",
        "@com_google_absl//absl/log:absl_check",
    ],
)

# Slice C catalog — Slice B + list / map literals, size, _in_,
# comprehension macros over scalar lists and maps.
# kStructExpr / kSelectExpr / has() / Customer activation are
# deferred to Slice C2.  See `grammar_aggregates.h`.
cc_library(
    name = "grammar_aggregates",
    srcs = ["grammar_aggregates.cc"],
    hdrs = ["grammar_aggregates.h"],
    deps = [
        ":grammar",
        ":grammar_scalars",
        "//shared:type",
        "@com_google_absl//absl/log:absl_check",
        "@com_google_absl//absl/strings",
    ],
)

# Type-directed CEL source generator.  Walks a Grammar honouring
# depth budget + leaf eligibility + per-production weights.
cc_library(
    name = "generator",
    srcs = ["generator.cc"],
    hdrs = ["generator.h"],
    deps = [
        ":grammar",
        ":grammar_scalars",
        "//shared:type",
        "@com_google_absl//absl/log:absl_check",
        "@com_google_absl//absl/strings",
    ],
)

cc_test(
    name = "generator_test",
    size = "small",
    srcs = ["generator_test.cc"],
    deps = [
        ":generator",
        ":grammar",
        ":grammar_scalars",
        "//compiler/frontend:parse_and_check",
        "//compiler/ir:annotations",
        "//compiler/ir:typed_ast",
        "//shared:type",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:status_matchers",
        "@com_google_absl//absl/strings",
        "@com_google_googletest//:gtest_main",
    ],
)

# Slice B oracle property — value-side differential test against
# cel-cpp via the testdata oracle.  See file header for the
# fuzz/unit-test mode interplay.
# Shared harness: build the full grammar, generate a source of a
# given type, run it through both our pipeline and cel-cpp, return
# the result.  Consumed by `cel_oracle_property_test` (fuzz-driven)
# and `mine_divergences` (loop-driven diagnostic).
cc_library(
    name = "oracle_harness",
    testonly = True,
    srcs = ["oracle_harness.cc"],
    hdrs = ["oracle_harness.h"],
    deps = [
        ":generator",
        ":grammar",
        ":grammar_aggregates",
        "//compiler:compiler",
        "//eval:activation",
        "//eval:engine",
        "//eval:instance",
        "//eval:value",
        "//shared:type",
        "//testdata:cel_cpp_oracle",
        "@com_google_absl//absl/log:absl_check",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/strings:string_view",
        "@com_google_cel_spec//proto/cel/expr:value_cc_proto",
    ],
)

# Loop-driven divergence miner.  Walks sequential seeds for one
# target type, prints each oracle divergence it finds along with
# the source / ours / oracle values.  Use when fuzztest's
# unit-test mode buffers the EXPECT_EQ output and the message
# never reaches the test log.  Run as `bazel run //e2e/fuzz:
# mine_divergences -- <target> <max_seeds> <depth> [stop_after]`.
# Recursive type-driven ours-vs-oracle value comparison (scalars,
# Single source of truth for the mineable target set (CLI name ->
# CelType).  mine_divergences + dump_samples both derive their
# `ParseTarget` from this so the two CLIs (and the scripts/fuzz.sh
# sweep list) cannot drift; targets_test pins the canonical list.
cc_library(
    name = "targets",
    srcs = ["targets.cc"],
    hdrs = ["targets.h"],
    deps = [
        "//shared:type",
        "@com_google_absl//absl/strings:string_view",
        "@com_google_absl//absl/types:span",
    ],
)

cc_test(
    name = "targets_test",
    size = "small",
    srcs = ["targets_test.cc"],
    deps = [
        ":targets",
        "//shared:type",
        "@com_google_absl//absl/strings:string_view",
        "@com_google_googletest//:gtest_main",
    ],
)

# lists, maps, nested) + printable renders for divergence logs.
cc_library(
    name = "compare",
    testonly = True,
    srcs = ["compare.cc"],
    hdrs = ["compare.h"],
    deps = [
        "//eval:cel_host",
        "//eval:value",
        "//shared:type",
        "@com_google_absl//absl/strings",
        "@com_google_cel_spec//proto/cel/expr:value_cc_proto",
    ],
)

cc_test(
    name = "compare_test",
    size = "small",
    srcs = ["compare_test.cc"],
    deps = [
        ":compare",
        "//eval:value",
        "//shared:type",
        "@com_google_cel_spec//proto/cel/expr:value_cc_proto",
        "@com_google_googletest//:gtest_main",
    ],
)

cc_binary(
    name = "mine_divergences",
    testonly = True,
    srcs = ["mine_divergences.cc"],
    tags = ["manual"],
    deps = [
        ":compare",
        ":oracle_harness",
        ":targets",
        "//eval:value",
        "//shared:type",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/strings:string_view",
        "@com_google_cel_spec//proto/cel/expr:value_cc_proto",
    ],
)

cc_test(
    name = "cel_oracle_property_test",
    size = "large",
    srcs = ["cel_oracle_property_test.cc"],
    # `manual` tag: this property test mines for real bugs.  It
    # WILL fail when it finds an oracle divergence on our side,
    # which is the whole point.  Excluded from `bazel test
    # //...` to keep the green-baseline CI clean; run explicitly
    # via `bazel test //e2e/fuzz:cel_oracle_property_test` (unit-
    # test mode, ~1000 iterations) or `bazel run --config=fuzztest
    # //e2e/fuzz:cel_oracle_property_test -- --fuzz=...` (long-
    # running coverage-guided mode).  Confirmed-discovery rows
    # become known_bugs_test.cc entries; see file header in
    # cel_oracle_property_test.cc.
    tags = ["manual"],
    deps = [
        ":oracle_harness",
        "//eval:value",
        "//shared:type",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/strings:string_view",
        "@com_google_cel_spec//proto/cel/expr:value_cc_proto",
        "@com_google_googletest//:gtest",
        "@fuzztest//fuzztest",
        "@fuzztest//fuzztest:fuzztest_gtest_main",
    ],
)

cc_test(
    name = "grammar_test",
    size = "large",
    srcs = ["grammar_test.cc"],
    deps = [
        ":grammar",
        ":grammar_scalars",
        ":grammar_aggregates",
        "//compiler/frontend:parse_and_check",
        "//compiler/ir:typed_ast",
        "//shared:type",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:status_matchers",
        "@com_google_absl//absl/strings",
        "@com_google_googletest//:gtest_main",
    ],
)
