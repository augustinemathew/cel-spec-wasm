load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

# Preview tool — dumps `<count>` generated expressions of
# `<target>` type at `<depth>` to stdout.  Useful for eyeballing
# what the grammar emits without writing a test.  Run as:
#   bazel run //e2e/fuzz:dump_samples -- bool 4 10
cc_binary(
    name = "dump_samples",
    srcs = ["dump_samples.cc"],
    tags = ["manual"],
    deps = [
        ":catalog",
        ":grammar",
        ":targets",
        "//shared:type",
        "@com_google_absl//absl/strings:string_view",
    ],
)

package(default_visibility = ["//visibility:public"])

# Smoke test proving the FuzzTest bzlmod wiring builds and runs
# end-to-end.  See fuzz_smoke_test.cc for the property body.
#
# Runs in unit-test mode under `bazel test`; turns into a coverage-
# guided fuzzer under `bazel run --config=fuzztest -- --fuzz=...`.
cc_test(
    name = "fuzz_smoke_test",
    size = "small",
    srcs = ["fuzz_smoke_test.cc"],
    deps = [
        "@com_google_googletest//:gtest",
        "@fuzztest//fuzztest",
        "@fuzztest//fuzztest:fuzztest_gtest_main",
    ],
)

# The engine: the typed-attribute grammar data model (Production /
# GrammarBuilder / Validate) AND the type-directed walker
# (GenCtx / GenerateExpr) that generates source from it.
cc_library(
    name = "grammar",
    srcs = ["grammar.cc"],
    hdrs = ["grammar.h"],
    deps = [
        "//shared:type",
        "@com_google_absl//absl/container:flat_hash_map",
        "@com_google_absl//absl/container:flat_hash_set",
        "@com_google_absl//absl/log:absl_check",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/strings:string_view",
    ],
)

# The catalog — WHAT generated expressions look like.  Data rows
# grouped by family (catalog_<family>.cc); catalog.cc's
# BuildGrammar() composes them in a fixed, generation-affecting
# order.  See `catalog.h`.
cc_library(
    name = "catalog",
    srcs = [
        "catalog.cc",
        "catalog_aggregates.cc",
        "catalog_leaves.cc",
        "catalog_ops.cc",
        "catalog_strings.cc",
        "catalog_temporal.cc",
    ],
    hdrs = ["catalog.h"],
    deps = [
        ":grammar",
        "//shared:type",
        "@com_google_absl//absl/log:absl_check",
        "@com_google_absl//absl/strings",
    ],
)

# Slice B oracle property — value-side differential test against
# cel-cpp via the testdata oracle.  See file header for the
# fuzz/unit-test mode interplay.
# Shared harness: build the full grammar, generate a source of a
# given type, run it through both our pipeline and cel-cpp, return
# the result.  Consumed by `cel_oracle_property_test` (fuzz-driven)
# and `mine_divergences` (loop-driven diagnostic).
cc_library(
    name = "oracle_harness",
    testonly = True,
    srcs = ["oracle_harness.cc"],
    hdrs = ["oracle_harness.h"],
    deps = [
        ":catalog",
        ":grammar",
        "//compiler:compiler",
        "//eval:activation",
        "//eval:engine",
        "//eval:instance",
        "//eval:value",
        "//shared:type",
        "//testdata:cel_cpp_oracle",
        "@com_google_absl//absl/log:absl_check",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/strings:string_view",
        "@com_google_cel_spec//proto/cel/expr:value_cc_proto",
    ],
)

# Single source of truth for the mineable target set (CLI name ->
# CelType).  mine_divergences + dump_samples both derive their
# `ParseTarget` from this so the two CLIs (and the scripts/fuzz.sh
# sweep list) cannot drift; targets_test pins the canonical list.
cc_library(
    name = "targets",
    srcs = ["targets.cc"],
    hdrs = ["targets.h"],
    deps = [
        "//shared:type",
        "@com_google_absl//absl/strings:string_view",
        "@com_google_absl//absl/types:span",
    ],
)

cc_test(
    name = "targets_test",
    size = "small",
    srcs = ["targets_test.cc"],
    deps = [
        ":targets",
        "//shared:type",
        "@com_google_absl//absl/strings:string_view",
        "@com_google_googletest//:gtest_main",
    ],
)

# The ONE verdict path: classify a generate→eval-both-sides
# round-trip, compare payloads, render the outcome.  Every driver
# (miner, property test) judges through RunOne so they cannot
# disagree about what a failure is.  Payload comparison is
# `conformance::CompareValue` — the same comparator the conformance
# gate scores with; there is deliberately only one in the repo.
cc_library(
    name = "verdict",
    testonly = True,
    srcs = ["verdict.cc"],
    hdrs = ["verdict.h"],
    deps = [
        ":oracle_harness",
        "//conformance:runner",
        "//shared:type",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/strings:string_view",
    ],
)

cc_test(
    name = "verdict_test",
    size = "medium",
    srcs = ["verdict_test.cc"],
    deps = [
        ":oracle_harness",
        ":verdict",
        "//eval:value",
        "//shared:type",
        "@com_google_absl//absl/status",
        "@com_google_cel_spec//proto/cel/expr:value_cc_proto",
        "@com_google_googletest//:gtest_main",
    ],
)

cc_binary(
    name = "mine_divergences",
    testonly = True,
    srcs = ["mine_divergences.cc"],
    tags = ["manual"],
    deps = [
        ":targets",
        ":verdict",
        "//shared:type",
        "@com_google_absl//absl/strings:string_view",
    ],
)

cc_test(
    name = "cel_oracle_property_test",
    size = "large",
    srcs = ["cel_oracle_property_test.cc"],
    # `manual` tag: this property test mines for real bugs.  It
    # WILL fail when it finds an oracle divergence on our side,
    # which is the whole point.  Excluded from `bazel test
    # //...` to keep the green-baseline CI clean; run explicitly
    # via `bazel test //e2e/fuzz:cel_oracle_property_test` (unit-
    # test mode, ~1000 iterations) or `bazel run --config=fuzztest
    # //e2e/fuzz:cel_oracle_property_test -- --fuzz=...` (long-
    # running coverage-guided mode).  Confirmed-discovery rows
    # become known_bugs_test.cc entries; see file header in
    # cel_oracle_property_test.cc.
    tags = ["manual"],
    # Static link: in Linux fastbuild's default dynamic mode, the
    # fuzztest→riegeli zstd shared object fails symbol resolution at
    # load time (undefined ZSTD_getDictID_fromDict) and the binary
    # dies before main.  macOS links this fine either way.
    linkstatic = True,
    deps = [
        ":verdict",
        "//shared:type",
        "@com_google_googletest//:gtest",
        "@fuzztest//fuzztest",
        "@fuzztest//fuzztest:fuzztest_gtest_main",
    ],
)

cc_test(
    name = "grammar_test",
    size = "large",
    srcs = ["grammar_test.cc"],
    deps = [
        ":catalog",
        ":grammar",
        "//compiler/frontend:parse_and_check",
        "//compiler/ir:typed_ast",
        "//shared:type",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:status_matchers",
        "@com_google_absl//absl/strings",
        "@com_google_googletest//:gtest_main",
    ],
)
