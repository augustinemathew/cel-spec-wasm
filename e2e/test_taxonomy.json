{
  "schema_version": 1,
  "_comment": "Machine-readable classification of every e2e suite by language/pipeline surface.  Human-readable mirror: e2e/README.md.  Kept in sync with e2e/BUILD.bazel by //e2e:taxonomy_validate_test.  Consumed by scripts/coverage/ to join per-suite coverage with surface cells.",
  "surfaces": {
    "lang/literals": "scalar literals, string/bytes escapes, syntax edges",
    "lang/idents": "identifier resolution, activation binding",
    "lang/select": "field select on protos/maps, has()",
    "lang/operators.arith": "arithmetic operators over int/uint/double",
    "lang/operators.compare": "ordering comparisons per kind and cross-numeric",
    "lang/operators.equality": "polymorphic equality / inequality",
    "lang/operators.logic": "&&, ||, !, ternary, 3VL error absorption",
    "lang/strings": "string/bytes built-ins: concat, size, contains, receiver ops",
    "lang/lists": "list literals, indexing, size, in, concat, repeated fields",
    "lang/maps": "map literals, lookup, in, size, key typing",
    "lang/comprehensions": "all/exists/exists_one/map/filter, two-var forms, transformList/Map/MapEntry, cel.bind",
    "lang/optionals": ".?, [?], optional.*, or/orValue, optMap/optFlatMap",
    "lang/conversions": "bool()/int()/uint()/double()/string()/bytes() and inter-conversions",
    "lang/type-values": "type(x), type idents, type equality",
    "lang/time": "timestamp/duration constructors, arithmetic, ordering, accessors, TZ",
    "lang/enums": "enum values, enum<->int, strong-typed enum semantics",
    "lang/proto.literal": "proto message literal construction (kStructExpr)",
    "lang/proto.field": "proto field read semantics, defaults, presence",
    "lang/proto.any": "google.protobuf.Any pack/unpack/equality",
    "lang/proto.wrappers": "the 9 wrapper WKTs, auto-wrap/unwrap",
    "lang/proto.wkt": "Value/Struct/ListValue-valued fields, null pruning",
    "lang/partial-eval": "unknowns, attribute patterns, partial-eval propagation",
    "ext/strings": "strings extension library",
    "ext/math": "math extension library",
    "ext/encoders": "encoders (base64) extension library",
    "ext/network": "network (IP/CIDR) extension library",
    "pipeline/limits": "fixed compilation limits: pass just inside, loud reject just past",
    "pipeline/link-modes": "dynamic vs static LinkMode parity",
    "pipeline/static-init": "__wasm_call_ctors / static initializer forcing functions",
    "pipeline/static-aggregates": "compile-time materialized const lists/maps in rodata",
    "pipeline/map-index": "runtime SwissTable map index parity",
    "pipeline/optimize": "Binaryen optimize_level output parity",
    "pipeline/persistence": "Program bytes round-trip across process/cache boundary",
    "pipeline/activation-marshal": "host->wasm activation marshalling at capacity boundaries",
    "pipeline/slots": "codegen slot allocation/reuse discipline",
    "pipeline/arena": "eval arena lifecycle, reset, OOM/poison propagation",
    "host/custom-fns": "@host custom functions via AddFunction/AddTypedFunction/BindFunction",
    "host/foreign-fns": "wasm-component foreign functions",
    "host/plugins": "plugin registration, dispatch, verification",
    "meta/known-bugs": "confirmed-defect registry, CELBUG pins",
    "meta/differential": "property-based differential testing against cel-cpp"
  },
