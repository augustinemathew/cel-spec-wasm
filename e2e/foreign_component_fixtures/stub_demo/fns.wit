package cel:customfn@0.1.0;

// One typed WIT function per custom fn. CEL types map concretely:
//   int->s64 uint->u64 double->f64 bool->bool string->string bytes->list<u8>
//   list<T>->list<wit T>   map<K,V>->list<tuple<wit K, wit V>>   proto->list<u8>
interface fns {
  add-ints:    func(a: s64, b: s64) -> s64;                       // primitives
  shout:       func(s: string) -> string;                        // string in/out
  sum-list:    func(xs: list<s64>) -> s64;                        // list<int>
  total:       func(m: list<tuple<string, s64>>) -> s64;         // map<string,int>
  grand-total: func(xss: list<list<s64>>) -> s64;                // list<list<int>>
  sum-by-key:  func(m: list<tuple<string, list<s64>>>, key: string) -> s64; // map<string,list<int>>
  byte-len:    func(b: list<u8>) -> u64;                          // bytes (proto = same shape)
}
world author { export fns; }
world host   { import fns; }
