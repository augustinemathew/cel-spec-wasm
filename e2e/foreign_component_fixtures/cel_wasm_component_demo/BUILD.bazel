# End-to-end demo fixture for the cel_wasm_component Starlark macro
# (m26 §6 + bazel/cel_wasm_component.bzl).
#
# Two targets:
#
#   - `demo_component` (default)
#       Scalar + string round-trip.  Cross-compiles to wasm32-wasi
#       via the existing wasi-sdk toolchain; the codec.h's absl::
#       Time / Duration deps come in via absl/time, which the macro
#       adds automatically (absl is already patched for wasm-sysinfo
#       in MODULE.bazel).
#
#   - `demo_component_proto` (manual)
#       Same macro, but the `.idl` declares `proto(acme.User)`
#       args / returns.  This drags `cc_proto_library` into the
#       wasm cross-compile, which means libprotobuf-cpp gets
#       compiled from source under the WASI sysroot — a cold-cache
#       multi-minute build.  Tagged `manual` so default `bazel
#       build //...` doesn't pay the cost; explicit `bazel build
#       //...:demo_component_proto` exercises the proto path.

load("@com_google_protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
load("@com_google_protobuf//bazel:proto_library.bzl", "proto_library")
load("//bazel:cel_wasm_component.bzl", "cel_wasm_component")

package(default_visibility = ["//visibility:public"])

# Non-proto demo — the fast hermetic gate.
cel_wasm_component(
    name = "demo_component",
    idl = "fns.idl",
    user_fns = ["user_fns.cc"],
)

# Proto demo — exercises the m24 §8 proto-as-bytes path.
proto_library(
    name = "user_proto",
    srcs = ["user.proto"],
)

cc_proto_library(
    name = "user_cc_proto",
    deps = [":user_proto"],
)

cel_wasm_component(
    name = "demo_component_proto",
    idl = "fns_proto.idl",
    user_fns = ["user_fns_proto.cc"],
    deps = [":user_cc_proto"],
    extra_includes = [
        "e2e/foreign_component_fixtures/cel_wasm_component_demo/user.pb.h",
    ],
    tags = ["manual"],
)
