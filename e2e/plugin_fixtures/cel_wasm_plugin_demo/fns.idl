// celfn IDL fixture for the cel_wasm_plugin macro demo.
//
// Two non-proto fns covering the common case (scalar in/out +
// string round-trip).  All decls are kPlugin
// (`@plugin.<fn>`) — m26 §7.5.1.

Module customfn;

string @plugin.greet(string name, int age);
int    @plugin.add(int a, int b);
// Used by bench/plugin_bench — the canonical string-payload
// dispatch cost.  Returns the input string's length so the bench
// measures the canonical-ABI copy throughput, not the user fn body.
int    @plugin.len(string s);

// Kind-matrix echo fns — one per canonical-ABI carrier the plugin
// boundary supports without protobuf: every primitive CEL type
// (int via `add` above, uint / double / bool / string / bytes here)
// plus list<int> and map<string,int>.  Each is echo-shaped so a single
// call exercises BOTH the lift (CEL -> component) and lower
// (component -> CEL) arm for its kind.
double @plugin.echo_double(double d);
uint   @plugin.echo_uint(uint u);
string @plugin.echo_string(string s);
bool   @plugin.negate(bool b);
bytes  @plugin.rev_bytes(bytes b);
list<int> @plugin.echo_list(list<int> xs);
map<string, int> @plugin.echo_map(map<string, int> m);

// Direction-isolating probes for the list carrier: one takes a list
// and returns a scalar, the other takes a scalar and returns a list.
int @plugin.sum_list(list<int> xs);
list<int> @plugin.iota(int n);

// Nested / non-string-key carriers — these reach codec arms the flat
// matrix above does not: the RECURSIVE list template (element needs
// its own lift/lower), the map lower's non-string-key branch, and
// LiftList/LowerList's recursion through a nested element type.
// Element-suffix coverage: `SuffixFor` (cpp_codec_emitter.cc) is only
// reached through a CONTAINER — a bare bool/int/uint/double passes
// through unwrapped with an empty struct name — so its bool / u64 /
// f64 arms need the primitive as a list element or map key/value, not
// as a plain argument.  `list<bool>` is deliberately ABSENT: the codec
// emits std::vector<bool>, whose bit-packed specialisation has no
// .data(), so the generated header does not compile (CELW-0021).
// bool reaches SuffixFor as a MAP VALUE instead.
list<bytes>  @plugin.echo_byteses(list<bytes> xs);
list<uint>   @plugin.echo_uints(list<uint> xs);
list<double> @plugin.echo_doubles(list<double> xs);
map<uint, bool> @plugin.echo_uint_bool_map(map<uint, bool> m);

list<string> @plugin.echo_strings(list<string> xs);
map<int, int> @plugin.echo_int_map(map<int, int> m);
list<list<int>> @plugin.echo_nested(list<list<int>> xs);
